; whiff's turn loop, which an (agent name :prompt "..." ...) file runs as
; the service name. whiff adds prompt, model (or ""), can (or []) and every
; (or 0s) as defs before these forms, and leaves out wake when there's no
; :every. With :can, a turn's tools are those whiff functions, through
; whiff mcp acting as the agent's session, :agent/<name>; without, it has
; none.
;
; Each message wakes Claude for one turn of the same session, so the agent
; remembers the whole conversation, days apart. A tell's answer lands in
; your inbox, and replying to it is your next message; an ask's goes back
; to whoever asked, as a whiff/done. Asks wait in the agent's inbox, and it
; takes them one at a time, oldest first. It has no tools.
; Its home, ~/.whiff/agents/<its name>, holds its session's id (Claude keeps
; sessions per directory) and the ids of the turns it started. Its turns are
; :agent's.

(def name (string/slice (value/to-string (self)) 1))
(def home (path/join (os/home) ".whiff" "agents" name))
(def session-file (path/join home "session")) ; the conversation's id
(def started (path/join home "started"))      ; the id once it has begun
(def turns (path/join home "turns"))          ; each turn's job id, a line each
(def wakes (path/join home "wakes"))          ; the scheduled ones' ids
(def asks (path/join home "asks"))            ; "turn ask" for each ask's turn
(def system (str "You are " name ", " """
  a long-running agent living in whiff, the user's personal message
  daemon. The user, and services of theirs, leave you messages, which
  arrive as turns of one conversation, sometimes days apart. Answer
  briefly and plainly: your answer goes back to whoever wrote,
  the user's inbox or the service that asked, and a reply to it is the
  next message.
  """ "\n" (if (vector/empty? can) "" (str """
  Your tools are the whiff functions you may use: a :write one waits for
  the user's review, so it is pending when your turn ends, and the user
  sees it then.
  """ "\n")) prompt))

(def (read-file path) (string/trim (or-else (file/read-text path) "")))
(def (read-lines path) (string/lines (or-else (file/read-text path) "")))

; session is the conversation's id, made on its first turn.
(def (session)
  (match [(read-file session-file) (read-file started)]
    [["" ""]
     (let [id (uuid/new)]
       (do (try (file/write session-file id)) (ok id)))]
    [["" s] (ok s)] ; begun before there was a session file
    [[s _] (ok s)]))

; mcp is whiff mcp, for claude's --mcp-config: the tools of a turn with :can.
(def mcp "{\"mcpServers\":{\"whiff\":{\"command\":\"whiff\",\"args\":[\"mcp\"]}}}")

(def (claude id)
  (vector/concat ["claude" "-p" "--tools" "" "--append-system-prompt" system]
    (if (= model "") [] ["--model" model])
    (if (vector/empty? can) [] ["--mcp-config" mcp "--strict-mcp-config" "--allowedTools" "mcp__whiff"])
    (if (= (read-file started) id) ["--resume" id] ["--session-id" id])))

; busy? is whether the last turn's job still runs.
(def (busy?)
  (match [(vector/last (read-lines turns)) (call :jobs/list)]
    [[(some last) (ok js)]
     (vector/any? js (fn ({:id i}) (= (int/to-string i) last)))]
    [_ #f]))

; start starts a turn's job with text: (ok id), its id as text.
(def (start text)
  (let [_ (try (file/mkdir home))
        opts {:stdin text :dir home :as :text :timeout 10m :origin :agent}
        id (int/to-string (try (submitted (call :jobs/run (claude (try (session)))
                                            (if (vector/empty? can) opts (map/set opts :session can))))))]
    (do (try (file/append turns (str id "\n")))
      (ok id))))

; turn starts one turn with text, a scheduled one if wake: (ok :thinking),
; or (err {:kind :busy}).
(def (turn text wake)
  (if (busy?)
    (err {:kind :busy :message (string/concat name " is still answering your last message; send it again in a moment")})
    (let [id (try (start text))]
      (do (if wake (try (file/append wakes (str id "\n"))) (ok :done))
        (ok :thinking)))))

; begun marks the session begun, once a turn has run in it.
(def (begun) (try (file/write started (try (session)))))

; ask-turns are [turn ask] for each ask's turn, both ids as text.
(def (ask-turns)
  (vector/filter (vector/map (read-lines asks) (fn (line) (string/split line " ")))
    (fn (p) (match p [[_ _] #t] [_ #f]))))

; asked is the ask that turn id answers: (some ask), or (none).
(def (asked id)
  (match (vector/find (ask-turns) (fn ([t _]) (= t id)))
    [(some [_ a]) (some a)]
    [(none) (none)]))

; next-ask starts a turn for the oldest ask in the inbox that hasn't one,
; unless a turn is running: (ok :waiting), (ok :idle) or (ok :thinking);
; an ask whose turn can't start, as the review gate refuses it, is answered
; with why: (ok :refused). whiff tells the agent of its asks again as each
; turn ends, each in its own sender's chain, which a turn's own must be.
(def (next-ask)
  (let [pairs (ask-turns)
        waiting (vector/filter (inbox :ask)
                  (fn ({:id i}) (not (vector/any? pairs (fn ([_ a]) (= a (int/to-string i)))))))]
    (match (vector/first waiting)
      [(none) (ok :idle)]
      [_ when (busy?) (ok :waiting)]
      [(some {:id i :args [text]})
       (match (start text)
         [(ok t) (do (try (file/append asks (str t " " i "\n"))) (ok :thinking))]
         [(err e) (do (reply i (err e)) (ok :refused))])])))

; reply-ask answers ask a, by its id, with an ask turn's result r.
(def (reply-ask a r)
  (let [i (unwrap (int/from-string a))]
    (match r
      [(ok answer) (do (begun) (reply i (ok (string/trim answer))))]
      [(err {:kind :exit :stderr e}) when (string/contains? e "already in use")
       (do (begun) (reply i (err {:kind :session :outcome :not-started :message "the session had already begun, so the message was lost; ask again"})))]
      [(err e) (reply i (err e))])))

; answered leaves a turn's answer in your inbox; a scheduled turn's
; "nothing" stays out of it.
(def (answered r wake)
  (match r
    [(ok answer) when (and wake (= (string/lower (string/trim answer)) "nothing"))
     (do (begun) (ok :done))]
    [(ok answer) (do (begun) (call :me/tell (string/trim answer)))]
    [(err {:kind :exit :stderr e}) when (string/contains? e "already in use")
     (do (begun)
       (call :me/tell "My session had already begun, so that message was lost; please send it again."))]
    [(err e) (call :me/tell (string/concat "I couldn't answer: " (value/to-string e)))]))

(on (tell text)
  "Leaves the agent a message: (ok :thinking) now, and its answer in your inbox; (err {:kind :busy}) while it answers the last one."
  (turn text #f))

(ask (ask text)
  "Asks the agent: pending at once, and [:whiff/done id (ok answer)] when its turn ends, or (err e) with :outcome. Asks wait their turn, oldest first.")

(on (whiff/asked id)
  "An ask waits in the inbox: its turn starts now, unless another is running. whiff's own; ask the agent instead."
  (next-ask))

(on (forget)
  "Ends the conversation: the next message starts a new one, which remembers nothing."
  (do (try (file/write session-file ""))
    (try (file/write started ""))
    (ok :forgotten)))

(on (wake)
  "A scheduled turn, which whiff sends every :every: it answers only if there's something to tell you. whiff's own loop: tell the agent instead."
  (do (send-after every :wake)
    (if (busy?)
      (ok :busy)
      (turn (str "This is your scheduled turn; you have one every " (value/to-string every)
              ". Look again at what the user asked you to keep track of. If there is nothing worth telling them, answer only: nothing")
        #t))))

(on (whiff/done id r)
  "A turn's answer goes to whoever asked, or to your inbox for a tell; your reply to that, if it is text, is the next message."
  (let [i (int/to-string id)]
    (cond
      [(vector/contains? (read-lines turns) i)
       (match (asked i)
         [(some a) (reply-ask a r)]
         [(none) (answered r (vector/contains? (read-lines wakes) i))])]
      [_ (match r
           [(ok text) when (= (value/type text) :string)
            (match (turn text #f)
              [(err {:kind :busy}) (call :me/tell "I'm still answering your last message; reply again in a moment.")]
              [res res])]
           [_ (ok :done)])])))
