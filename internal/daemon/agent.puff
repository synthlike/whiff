; whiff's turn loop, which an (agent name :prompt "..." ...) file runs as
; the service name. whiff adds prompt, model (or ""), can (or []), dir (or
; "", an absolute path), limits ({:turn usd :day usd :time d :tasks n}) and every
; (or 0s) as defs before these forms, and leaves out wake when there's no
; :every. A turn's tools are the :can whiff functions and the agent's own
; later, through whiff mcp acting as the agent's session, :agent/<name>;
; or, for a :model that names its provider, through huff, which runs the
; turn itself and keeps the conversation in a transcript in its home.
;
; Each message wakes Claude for one turn of the same session, so the agent
; remembers the whole conversation, days apart. A tell's answer lands in
; your inbox, and replying to it is your next message; an ask's goes back
; to whoever asked, as a whiff/done. Tells, asks and scheduled wakes all
; wait in the agent's inbox, and it takes them one at a time, oldest first. A turn stops at :limits' :turn
; dollars or :time; once the agent has spent :day dollars in the last 24
; hours it takes no more turns until it has spent less, and you hear once.
; Its home, ~/.whiff/agents/<its name>, holds its session's id (Claude keeps
; sessions per directory), the ids of the turns it started and what each
; cost. Its turns are :agent's.

(def name (string/slice (value/to-string (self)) 1))
(def home (path/join (os/home) ".whiff" "agents" name))
(def session-file (path/join home "session")) ; the conversation's id
(def started (path/join home "started"))      ; the id once it has begun
(def turns (path/join home "turns"))          ; each turn's job id, a line each
(def asks (path/join home "asks"))            ; "turn message kind [root]" for each turn: kind is ask, tell, wake or whiff/result
(def deferred (path/join home "deferred"))    ; each ask turn whose answer waits for the tasks it started
(def costs (path/join home "costs"))          ; "time usd" for each turn, "time usd - project" for one in a project, "time usd task" for a task's, the last 24 hours'
(def paused-file (path/join home "paused"))   ; "paused" while it takes no turns
(def later-file (path/join home "later"))     ; [{:id :due :note}], the turns it set itself with later
(def current-file (path/join home "current")) ; {:turn :text}, the last turn started and what it was given
(def failed-file (path/join home "failed"))   ; [{:turn :text :why}], the last turns that failed, which restart takes again
(def day-usd (unwrap (map/get limits :day)))
(def turn-usd (unwrap (map/get limits :turn)))
(def system (str "You are " name ", " """
  a long-running agent living in whiff, the user's personal message
  daemon. The user, and services of theirs, leave you messages, which
  arrive as turns of one conversation, sometimes days apart. Answer
  briefly and plainly: your answer goes back to whoever wrote,
  the user's inbox or the service that asked, and a reply to it is the
  next message. When the user needn't hear anything, answer only:
  nothing
  """ "\n" (if (vector/empty? can) "" (str """
  Your tools are the whiff functions you may use: a :write one waits for
  the user's review, and another agent's ask for its answer. Don't wait
  for them: end your turn, and each result comes to you later as a
  message of its own.
  """ "\n")) "To look at something again later, call your tool " name "_later with\n"
  """
  a duration, as 2h or 1d, and a note to yourself: once it has passed,
  the note comes back to you as a turn of its own.
  """ "\n" prompt))

(def (read-file path) (string/trim (or-else (file/read-text path) "")))
(def (read-lines path) (string/lines (or-else (file/read-text path) "")))

; session is the conversation's id, made on its first turn.
(def (session)
  (match [(read-file session-file) (read-file started)]
    [["" ""]
     (let [id (uuid/new)]
       (do (try (file/write session-file id)) (ok id)))]
    [["" s] (ok s)] ; begun before there was a session file
    [[s _] (ok s)]))

; mcp is whiff mcp, for claude's --mcp-config: a turn's tools, which act
; in dir, or the agent's home.
(def mcp (json/to-string {:mcpServers {:whiff {:command "whiff" :args (if (= dir "") ["mcp"] ["mcp" "--dir" dir])}}}))

; tools are what a turn may call: :can, and the agent's own later.
(def tools (vector/append can (unwrap (keyword/from-string (str name "/later")))))

; huff? is whether the agent runs on huff: a :model that names its
; provider, as openrouter/moonshotai/kimi-k2, rather than Claude's.
(def huff? (string/contains? model "/"))

; claude is a turn's command in session id: claude -p, whose tools are
; whiff mcp's; or, on huff, huff, whose tools are the session's own, with
; the conversation in a transcript file in its home.
(def (claude id)
  (if huff?
    (vector/concat ["huff" "-json" "-m" model "-s" system "-t" (path/join home (str "huff-" id ".puff"))
                    "-usd" (float/to-string turn-usd)]
      (if (= dir "") [] ["-dir" dir]))
    (claude-p id)))

(def (claude-p id)
  (vector/concat ["claude" "-p" "--tools" "" "--append-system-prompt" system
                  "--verbose" "--output-format" "stream-json" "--max-budget-usd" (float/to-string turn-usd)]
    (if (= model "") [] ["--model" model])
    ["--mcp-config" mcp "--strict-mcp-config" "--allowedTools" "mcp__whiff"]
    (if (= (read-file started) id) ["--resume" id] ["--session-id" id])))

; busy? is whether the last turn runs: its message is in the inbox until
; the agent has its answer, after its job ends, unless it is an ask whose
; answer waits for the tasks the turn started. A turn from before turns
; kept their message runs while its job does.
(def (busy?)
  (match (vector/last (read-lines turns))
    [(none) #f]
    [(some last)
     (match [(asked last) (call :jobs/list)]
       [[(some [a _]) _] (and (not (vector/contains? (read-lines deferred) last))
                           (vector/any? (inbox) (fn ({:id i}) (= (int/to-string i) a))))]
       [[(none) (ok js)] (vector/any? js (fn ({:id i}) (= (int/to-string i) last)))]
       [_ #f])]))

; dollars is usd for people, in cents: $0.42, $5.00; "under $0.01" for a
; spend that rounds to nothing, as a cheap model's turn does.
(def (dollars usd)
  (let [cents (unwrap (int/from-float (float/round (* usd 100.0))))
        c (int/rem cents 100)]
    (if (and (> usd 0.0) (= cents 0))
      "under $0.01"
      (str "$" (int/to-string (int/div cents 100)) "." (if (< c 10) "0" "") (int/to-string c)))))

; spending are [time usd task project] for the last 24 hours: each
; turn's, task "", and each task's its result said it cost, task its id;
; project is the project a turn's work was in, "" for none or a task's.
(def (spending)
  (let [since (- (time/now) 1d)
        parse (fn (t c task project)
                (match [(time/from-string t) (float/from-string c)]
                  [[(ok at) (ok usd)] [at usd task project]]
                  [_ [since 0.0 task project]]))]
    (vector/filter
      (vector/map (read-lines costs)
        (fn (line)
          (match (string/split line " ")
            [[t c] (parse t c "" "")]
            [[t c "-" & p] (parse t c "" (string/join p " "))]
            [[t c task] (parse t c task "")]
            [_ [since 0.0 "" ""]])))
      (fn ([at _ _ _]) (> at since)))))

; spent is the dollars of the last 24 hours, its turns' and its tasks'.
(def (spent) (vector/reduce (spending) 0.0 (fn (sum [_ usd _ _]) (+ sum usd))))

; turns-today is how many turns it took in the last 24 hours.
(def (turns-today) (vector/length (vector/filter (spending) (fn ([_ _ task _]) (= task "")))))

; by-project is what its turns of the last 24 hours spent on each
; project, {"tally" usd}: not its tasks', which the tasks' own services
; count, as pipeline's runs.
(def (by-project)
  (vector/reduce (spending) {}
    (fn (m [_ usd task p])
      (if (or (not (= task "")) (= p ""))
        m
        (map/set m p (+ (map/get-or m p 0.0) usd))))))

; spend keeps what a turn cost, in project, "" for none, or task's, if it
; isn't "", and tells you once the day's budget is spent.
(def (spend usd task project)
  (let [before (spent)
        line (fn (at c tk p)
               (str (time/to-string at) " " (float/to-string c)
                 (cond [(not (= tk "")) (str " " tk)] [(not (= p "")) (str " - " p)] [_ ""]) "\n"))
        kept (vector/map (spending) (fn ([at c tk p]) (line at c tk p)))
        _ (try (file/write costs (string/concat (vector/reduce kept "" string/concat) (line (time/now) usd task project))))
        after (+ before usd)]
    (if (and (< before day-usd) (>= after day-usd))
      (call :me/tell (str name " has spent " (dollars after) " in the last 24 hours, its " (dollars day-usd)
                       " a day: it takes no more turns until it has spent less. (call :" name "/usage) says where it is."))
      (ok :done))))

; start starts a turn's job with text: (ok id), its id as text; (err
; {:kind :over-budget}) once the day's budget is spent.
(def (start text)
  (let [_ (try (over-budget))
        _ (try (file/mkdir home))
        opts {:stdin text :dir home :timeout (unwrap (map/get limits :time)) :origin :agent :session tools :stream #t :output :file}
        id (int/to-string (try (submitted (call :jobs/run (claude (try (session))) opts))))]
    (do (try (file/append turns (str id "\n")))
      (ok id))))

; over-budget is (err {:kind :over-budget}) once the day's budget is
; spent, else (ok :done).
(def (over-budget)
  (let [usd (spent)]
    (if (>= usd day-usd)
      (err {:kind :over-budget :outcome :not-started
            :message (str name " has spent " (dollars usd) " in the last 24 hours, its " (dollars day-usd) " a day")})
      (ok :done))))

; number is a JSON number as a float.
(def (number x) (if (= (value/type x) :int) (float/from-int x) x))

; outcome is what turn i's job result r answers: (ok text), or (err e)
; with :outcome. A turn's cost is kept, as what it spent is spent however
; it ended.
(def (outcome i r)
  (match r
    [(ok {:exit n :stdout out :stderr e})
     (match (json/parse out)
       [(ok res) when (= (map/get res :type) (some "result"))
        (let [usd (number (map/get-or res :total_cost_usd 0))
              _ (spend usd "" (or-else (project/name) ""))
              why (string/join (map/get-or res :errors []) "; ")]
          (cond
            [(not (map/get-or res :is_error #f)) (ok (map/get-or res :result ""))]
            [(string/contains? why "already in use") ; as claude says it on stderr in text mode
             (err {:kind :exit :exit n :message (str "job " i " exited " (int/to-string n)) :stderr why})]
            [(= (map/get res :subtype) (some "error_max_budget_usd"))
             (err {:kind :over-budget :outcome :stopped :cost usd
                   :message (str "the turn reached its " (dollars turn-usd) " and stopped: " why)})]
            [_ (err {:kind :turn :outcome :stopped :cost usd :message (str "the turn failed: " why)})]))]
       [_ when (= n 0) (ok out)]
       [_ (err {:kind :exit :exit n :message (str "job " i " exited " (int/to-string n)) :stderr e})])]
    [(err e) (err e)]))

; begun marks the session begun, once a turn has run in it.
(def (begun) (try (file/write started (try (session)))))

; ask-turns are [turn message kind root] for each turn a message in the
; inbox began, ids as text and kind "ask", "tell", "wake" or
; "whiff/result". A result's root is the turn the task it tells of was
; started for, followed back through results; any other's is itself.
(def (ask-turns)
  (vector/reduce (read-lines asks) []
    (fn (all line)
      (match (string/split line " ")
        [[t a k r] (vector/append all [t a k r])]
        [[t a k] (vector/append all [t a k t])]
        [[t a] (vector/append all [t a "ask" t])] ; from before tells queued
        [_ all]))))

; asked is what turn id answers: (some [message kind]), or (none).
(def (asked id)
  (match (vector/find (ask-turns) (fn ([t _ _ _]) (= t id)))
    [(some [_ a k _]) (some [a k])]
    [(none) (none)]))

; taken-by are the messages turn id took, ints: one, or the results it
; took together.
(def (taken-by id)
  (vector/reduce (ask-turns) []
    (fn (all [t a _ _])
      (if (= t id) (vector/append all (unwrap (int/from-string a))) all))))

; root-of is turn id's root, as text: itself unless it was a result's.
(def (root-of id)
  (match (vector/find (ask-turns) (fn ([t _ _ _]) (= t id)))
    [(some [_ _ _ r]) r]
    [(none) id]))

; turn-of is the turn that started task id, an int, as text: the last
; before it, as whiff numbers tasks and jobs alike, and the agent's
; session lasts a turn. "" for one from before its first turn.
(def (turn-of id)
  (vector/reduce (read-lines turns) ""
    (fn (last t)
      (match (int/from-string t)
        [(ok n) when (< n id) t]
        [_ last]))))

; open-for are the tasks that haven't ended which were started for root,
; a turn: by it, or by the turns of their results.
(def (open-for root)
  (vector/filter (or-else (session/tasks) [])
    (fn (t) (= (root-of (turn-of t)) root))))

; waits? is whether ask a is still in the inbox, its answer to come.
(def (waits? a) (vector/any? (inbox) (fn ({:id i}) (= (int/to-string i) a))))

(def wake-text (str "This is your scheduled turn; you have one every " (value/to-string every)
                 ". Look again at what the user asked you to keep track of. If there is nothing worth telling them, answer only: nothing"))

; laters are the turns the agent set itself with later, [{:id :due :note}].
(def (laters) (or-else (value/from-string (read-file later-file)) []))

; set-laters keeps ls as the agent's laters.
(def (set-laters ls) (file/write later-file (value/to-string ls)))

; arm-laters sets a timer for each later whose remind isn't in the inbox
; yet, one past due at once: whiff's start and a reload drop an agent's
; timers to itself, and its :start calls this.
(def (arm-laters)
  (let [ls (laters)]
    (if (vector/empty? ls)
      (ok :armed)
      (let [now (time/now)
            queued (vector/map (inbox :remind) (fn ({:args [i _]}) i))]
        (do (vector/each ls
              (fn ({:id i :due due :note note})
                (if (vector/contains? queued i)
                  (ok :done)
                  (send-after (if (> due now) (- due now) 0s) :remind i note))))
          (ok :armed))))))

; later-text is a remind's turn text.
(def (later-text note)
  (str "This is a turn you set yourself with " name "_later, saying: " note
    " If there is nothing worth telling the user, answer only: nothing"))

; held? is whether inbox item m is a result whose turn started other
; tasks that haven't ended: it waits for them, so that their results
; take one turn together rather than one each.
(def (held? m)
  (match m
    [{:fn :whiff/result :args [t _]}
     (let [by (turn-of t)]
       (vector/any? (or-else (session/tasks) []) (fn (o) (and (not (= o t)) (= (turn-of o) by)))))]
    [_ #f]))

; results-with are the results in waiting, inbox items, of the tasks the
; turn that started task t started, t's among them: what one turn takes.
(def (results-with waiting t)
  (let [by (turn-of t)]
    (vector/filter waiting
      (fn (m) (match m [{:fn :whiff/result :args [o _]} (= (turn-of o) by)] [_ #f])))))

; result-cost is what result r, of a task a turn started, says it cost:
; (ok {:cost usd ...}), as a pipeline build's, or another agent's ask's
; that says so; anything else cost the agent nothing it knows of: 0.0.
(def (result-cost r)
  (match r
    [(ok m) when (= (value/type m) :map)
     (match (map/get m :cost)
       [(some usd) when (and (vector/contains? [:int :float] (value/type usd)) (> (number usd) 0.0)) (number usd)]
       [_ 0.0])]
    [_ 0.0]))

; child-cost spends what result r, of task, says it cost, if anything.
(def (child-cost task r)
  (let [usd (result-cost r)]
    (if (> usd 0.0) (spend usd (int/to-string task) "") (ok :done))))

; result-text is a turn's text for results, inbox items of the tasks an
; earlier turn of the agent's started, for root. For an ask that waits,
; the answer is the ask's, once nothing else started for it runs.
(def (result-text results root)
  (let [ids (vector/map results (fn ({:args [t _]}) t))
        ended (string/join
                (vector/map results
                  (fn ({:args [t r]}) (str "Task " (int/to-string t) ", which you started in an earlier turn, has ended: " (value/to-string r) ".")))
                " ")
        others (vector/filter (open-for root) (fn (o) (not (vector/contains? ids o))))]
    (match (asked root)
      [(some [a "ask"]) when (and (waits? a) (vector/empty? others))
       (str ended " Carry on with what it was for: your answer now goes to whoever asked you, as your answer to their message.")]
      [(some [a "ask"]) when (waits? a)
       (str ended " Tasks " (string/join (vector/map others int/to-string) ", ")
         " you started for the same message haven't ended: you'll answer once they have. For now answer only: nothing")]
      [_ (str ended " Carry on with what it was for. If the user should hear of it, say so in your answer; otherwise answer only: nothing")])))

; paused? is whether you paused the agent: its messages wait.
(def (paused?) (= (read-file paused-file) "paused"))

; next-ask starts a turn for the oldest message in the inbox, a tell, an
; ask, a wake or a result, that hasn't one, unless a turn is running or
; the agent is paused. A result waits for the others its turn started,
; then takes one turn with them, its root's; so it is unless
; the agent is paused: (ok :waiting), (ok :paused), (ok :idle) or (ok
; :thinking). One whose turn can't start, as the review
; gate or the day's budget refuses it, is answered with why: (ok
; :refused). A wake sets the next as it leaves the queue. whiff tells the
; agent of its messages again as each turn ends, each in its own sender's
; chain, which a turn's own must be.
(def (next-ask)
  (let [taken (ask-turns)
        waiting (vector/filter (inbox)
                  (fn ({:id i}) (not (vector/any? taken (fn ([_ a _ _]) (= a (int/to-string i)))))))]
    (match (vector/find waiting (fn (m) (not (held? m))))
      [(none) (ok :idle)]
      [_ when (paused?) (ok :paused)]
      [_ when (busy?) (ok :waiting)]
      [(some {:id i :fn f :args args})
       (let [_ (match [f args]
                 [[:wake _] (send-after every :wake)]
                 [[:remind [l _]] (set-laters (vector/filter (laters) (fn ({:id o}) (not (= o l)))))]
                 [_ (ok :done)])
             root (match [f args] [[:whiff/result [t _]] (root-of (turn-of t))] [_ ""])
             batch (match [f args] [[:whiff/result [t _]] (results-with waiting t)] [_ [{:id i}]])
             text (match [f args]
                    [[:whiff/result _] (result-text batch root)]
                    [[:remind [_ note]] (later-text note)]
                    [[_ [t]] t]
                    [_ wake-text])]
         ; What the results' tasks spent is the agent's, spent before
         ; the turn they start, which the day's budget may then refuse.
         (vector/each batch (fn (m) (match m [{:fn :whiff/result :args [t r]} (let [_ (child-cost t r)] (ok :done))] [_ (ok :done)])))
         (match (start text)
           [(ok t) (do (try (file/write-atomic current-file (value/to-string {:turn t :text text})))
                     (vector/each batch
                       (fn ({:id m}) (try (file/append asks (str t " " (int/to-string m) " " (keyword/name f) (if (= root "") "" (str " " root)) "\n")))))
                     (ok :thinking))]
           [(err e) (do (reply i (err e)) (ok :refused))]))])))

; reply-ask answers ask i with an ask turn's result r.
(def (reply-ask i r)
  (match r
    [(ok answer) (do (begun) (reply i (ok (string/trim answer))))]
    [(err {:kind :exit :stderr e}) when (string/contains? e "already in use")
     (do (begun) (reply i (err {:kind :session :outcome :not-started :message "the session had already begun, so the message was lost; ask again"})))]
    [(err e) (reply i (err e))]))

; finished answers message a, of kind, with turn's outcome o: an ask's
; sender gets the answer, once the tasks the turn started have ended; a
; tell's answer goes to your inbox and its sender hears it was told; a
; wake's, if it has news, to your inbox. A result's answers the ask it
; was for, if that waits and nothing else started for it runs; else, if
; it has news, it goes to your inbox.
(def (finished turn a kind o)
  (let [i (unwrap (int/from-string a))]
    (match kind
      ["ask" when (match o [(ok _) (not (vector/empty? (open-for turn)))] [_ #f])
       (do (begun) (try (file/append deferred (str turn "\n"))) (ok :deferred))]
      ["ask" (reply-ask i o)]
      ["whiff/result"
       (let [root (root-of turn)
             done (fn () (vector/each (taken-by turn) (fn (m) (reply m (ok :done)))))]
         (match (asked root)
           [(some [ra "ask"]) when (waits? ra)
            (if (vector/empty? (open-for root))
              (let [_ (reply-ask (unwrap (int/from-string ra)) o)] (done))
              (do (begun) (done)))]
           [_ (let [_ (answered turn (with-spent o) #t)] (done))]))]
      ; answered's is your inbox's pending: what the sender hears is reply's.
      ["tell" (let [_ (answered turn o #t)] (reply i (match o [(ok _) (ok :told)] [e e])))]
      [_ (let [_ (answered turn o #t)] (reply i (ok :done)))])))

; with-spent is a result turn's outcome o with, after its answer, what
; the agent has spent, its turns' and its tasks': it reports on work it
; handed out, and what that cost is whiff's to say, not the model's. An
; answer of nothing stays nothing.
(def (with-spent o)
  (match o
    [(ok answer) when (not (= (string/lower (string/trim answer)) "nothing"))
     (ok (str (string/trim answer) "\n\n" name " has spent " (dollars (spent)) " in the last 24 hours, its turns and its tasks, of its " (dollars day-usd) " a day."))]
    [_ o]))

; answered leaves turn's answer r in your inbox, unless it is "nothing"
; and quiet, as a tell's, a wake's or a result's may be. A turn that
; claude didn't start, as its session had begun, ran nothing: it is taken
; again, resuming the session, once. One that failed once it ran may have
; done some of its work, so it isn't run again on its own: you hear why,
; and may restart it.
(def (answered turn r quiet)
  (match r
    [(ok answer) when (and quiet (= (string/lower (string/trim answer)) "nothing"))
     (do (begun) (ok :done))]
    [(ok answer) (do (begun) (call :me/tell (string/trim answer)))]
    [(err {:kind :exit :stderr e}) when (string/contains? e "already in use")
     (do (begun)
       (match (current turn)
         [(some text) (send :tell text)]
         [(none) (call :me/tell "My session had already begun, so that message was lost; please send it again.")]))]
    [(err e) (failed-turn turn e)]))

; current is the text turn was given, if it is the last turn started.
(def (current turn)
  (match (value/from-string (read-file current-file))
    [(ok {:turn t :text text}) when (= t turn) (some text)]
    [_ (none)]))

; failed-turns are the turns that failed which restart may take again,
; [{:turn :text :why}], the last 10.
(def (failed-turns) (or-else (value/from-string (read-file failed-file)) []))

(def (set-failed fs)
  (file/write-atomic failed-file (value/to-string (vector/slice fs (max 0 (- (vector/length fs) 10)) (vector/length fs)))))

; failed-turn tells you turn failed with e, offering to restart it: not
; one you cancelled, nor one the budget stopped, which would only stop
; again, nor one whose text is gone.
(def (failed-turn turn e)
  (let [stderr (string/trim (map/get-or e :stderr ""))
        why (str (map/get-or e :message (value/to-string e))
              (match (vector/last (string/lines stderr)) [(some l) when (not (= l "")) (str ": " l)] [_ ""]))
        say (str "I couldn't answer: " why)]
    (match [(map/get-or e :kind :none) (current turn)]
      [[:cancelled _] (call :me/tell say)]
      [[:over-budget _] (call :me/tell say)]
      [[_ (some text)]
       (do (try (set-failed (vector/append (failed-turns) {:turn turn :text text :why why})))
         (call :me/tell (str say "\n\nWhat the turn did before it failed stays done. Restarting it takes its message again, telling me what it had started, so I carry on rather than do it twice.")
           {:actions [{:label "Restart the turn" :action [(unwrap (keyword/from-string (str name "/restart"))) (unwrap (int/from-string turn))]}]}))]
      [_ (call :me/tell say)])))

; started-by says what turn, a failed one, had started: each task of the
; agent's work today whose turn it was, with how it stands.
(def (started-by turn)
  (let [work (match (service/status (self)) [(ok s) (map/get-or s :work [])] [_ []])
        mine (vector/filter work (fn ({:id i}) (= (turn-of i) turn)))]
    (if (vector/empty? mine)
      "It started no tasks that whiff kept; calls that answered at once may have run, so check before writing anything again."
      (str "The tasks it started: "
        (string/join (vector/map mine
                       (fn (w) (str (int/to-string (unwrap (map/get w :id))) " to " (value/to-string (unwrap (map/get w :to)))
                                 ", " (match (map/get w :result)
                                        [(some r) (str "ended " (value/to-string r))]
                                        [(none) (str "still " (keyword/name (map/get-or w :status :waiting)))]))))
          "; ")
        ". Their results come to you as messages of their own; don't start them again."))))

(def (restart-text turn why text)
  (str "Your turn on the message below was cut off before it finished: " why
    ". What it did stays done. " (started-by turn)
    " Look back at what you did in that turn, and carry on from where it stopped.\n\nThe message was:\n\n" text))

(ask (tell text)
  "Leaves the agent a message: pending at once, its answer in your inbox, and (ok :told) for the sender when its turn ends. Messages wait their turn, oldest first.")

(ask (ask text)
  "Asks the agent: pending at once, and [:whiff/done id (ok answer)] when its turn ends, or (err e) with :outcome. Asks wait their turn, oldest first.")

(on (whiff/asked id)
  "A message waits in the inbox: its turn starts now, unless another is running. whiff's own; ask or tell the agent instead."
  (next-ask))

(on (usage) :read
  "What the agent spent: {:spent usd :turns n :day usd :projects {name usd}}, the dollars and turns of the last 24 hours, its :day limit, and what its turns, not its tasks, spent on each project, as board counts a team's day."
  (ok {:spent (spent) :turns (turns-today) :day day-usd :projects (by-project)}))

(on (stop)
  "Stops the turn running now: its job is cancelled, and whoever it answers hears (err {:kind :cancelled}). (ok :idle) if none runs."
  (match (vector/last (read-lines turns))
    [(some last) when (busy?) (call :jobs/cancel (unwrap (int/from-string last)))]
    [_ (ok :idle)]))

(on (cancel)
  "Cancels what the agent is doing: pauses it, so what comes back waits for you to resume it rather than starting turns; stops the turn running now; and cancels each task its turns handed out that hasn't ended, whose services hear of it, as pipeline stops the run it began. (ok {:turn t :tasks ids}), t the stopped turn's job or :none."
  (do (try (file/mkdir home))
    (try (file/write paused-file "paused"))
    (let [turn (match (vector/last (read-lines turns))
                 [(some last) when (busy?)
                  (let [j (unwrap (int/from-string last))] (do (or-else (call :jobs/cancel j) :gone) j))]
                 [_ :none])]
      (ok {:turn turn :tasks (unwrap (session/cancel))}))))

(on (restart turn)
  "Takes turn, one that failed once it ran, again as a new turn of the same conversation: it gets the message it had, why it failed and the tasks it had started, so it carries on rather than does them twice. Its answer comes to your inbox, as a tell's. (ok :restarting); (err {:kind :no-turn}) for a turn that didn't fail so, or was restarted."
  (let [i (if (= (value/type turn) :int) (int/to-string turn) turn)]
    (match (vector/find (failed-turns) (fn ({:turn t}) (= t i)))
      [(some {:why why :text text})
       (let [_ (try (set-failed (vector/filter (failed-turns) (fn ({:turn t}) (not (= t i))))))
             _ (send :tell (restart-text i why text))] ; pending: a tell waits its turn
         (ok :restarting))]
      [(none) (err {:kind :no-turn :message (str "turn " i " didn't fail once it ran, or was restarted already")})])))

(on (pause)
  "Pauses the agent: it takes no more turns, and messages wait in its inbox until you resume it; a turn running now ends as it would. Scheduled wakes don't pile up: the next is set as one is taken."
  (do (try (file/mkdir home))
    (try (file/write paused-file "paused"))
    (ok :paused)))

(on (resume)
  "Resumes a paused agent: it takes what waits in its inbox, oldest first. (ok :thinking), or (ok :idle) if nothing waits."
  (do (try (file/write paused-file ""))
    (next-ask)))

(on (forget)
  "Ends the conversation: the next message starts a new one, which remembers nothing."
  (do (try (file/write session-file ""))
    (try (file/write started ""))
    (ok :forgotten)))

(ask (whiff/result id r)
  "A task one of the agent's turns started, as a call to a :write function or another agent's ask, ended with r: it waits its turn, and the turn answers only with news. whiff's own.")

(on (later d note) :read
  "Sets the agent a turn of its own once d has passed, as 1d, with note, what to look at: it waits its turn, as a wake does, and answers only with news. (ok due), when it comes. :read, as it writes nothing but the agent's home: its turn's tools are gated as any. The agent's own tool."
  (if (and (= (value/type d) :duration) (>= d 0s) (= (value/type note) :string))
    (let [due (+ (time/now) d)
          i (uuid/new)
          _ (try (file/mkdir home))
          _ (try (set-laters (vector/append (laters) {:id i :due due :note note})))
          _ (try (send-after d :remind i note))]
      (ok due))
    (err {:kind :bad-call :message (str "later wants a duration of 0s or more and a note, got " (value/to-string d) " and " (value/to-string note))})))

(ask (remind id note)
  "A turn the agent set itself with later, which waits its turn: it answers only if there's something to tell you. whiff's own: use later.")

(ask (wake)
  "A scheduled turn, which whiff sends every :every and which waits its turn: it answers only if there's something to tell you. whiff's own loop: tell the agent instead.")

(on (whiff/done id r)
  "A turn's answer goes to whoever asked, or to your inbox for a tell; your reply to that, if it is text, is the next message."
  (let [i (int/to-string id)]
    (cond
      [(vector/contains? (read-lines turns) i)
       (let [o (outcome i r)]
         (match (asked i)
           [(some [a k]) (finished i a k o)]
           [(none) (answered i o #f)]))] ; a turn from before tells queued
      ; Your reply to an answer is a tell, which waits its turn.
      [_ (match r
           [(ok text) when (= (value/type text) :string) (send :tell text)]
           [_ (ok :done)])])))
