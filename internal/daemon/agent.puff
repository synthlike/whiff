; whiff's turn loop, which an (agent name :prompt "..." ...) file runs as
; the service name. whiff adds prompt, model (or ""), can (or []), dir (or
; "", an absolute path), limits ({:turn usd :day usd :time d}) and every
; (or 0s) as defs before these forms, and leaves out wake when there's no
; :every. With :can, a turn's tools are those whiff functions, through
; whiff mcp acting as the agent's session, :agent/<name>; without, it has
; none.
;
; Each message wakes Claude for one turn of the same session, so the agent
; remembers the whole conversation, days apart. A tell's answer lands in
; your inbox, and replying to it is your next message; an ask's goes back
; to whoever asked, as a whiff/done. Tells, asks and scheduled wakes all
; wait in the agent's inbox, and it takes them one at a time, oldest first. A turn stops at :limits' :turn
; dollars or :time; once the agent has spent :day dollars in the last 24
; hours it takes no more turns until it has spent less, and you hear once.
; Its home, ~/.whiff/agents/<its name>, holds its session's id (Claude keeps
; sessions per directory), the ids of the turns it started and what each
; cost. Its turns are :agent's.

(def name (string/slice (value/to-string (self)) 1))
(def home (path/join (os/home) ".whiff" "agents" name))
(def session-file (path/join home "session")) ; the conversation's id
(def started (path/join home "started"))      ; the id once it has begun
(def turns (path/join home "turns"))          ; each turn's job id, a line each
(def asks (path/join home "asks"))            ; "turn message kind [root]" for each turn: kind is ask, tell, wake or whiff/result
(def deferred (path/join home "deferred"))    ; each ask turn whose answer waits for the tasks it started
(def costs (path/join home "costs"))          ; "time usd" for each turn, the last 24 hours'
(def paused-file (path/join home "paused"))   ; "paused" while it takes no turns
(def day-usd (unwrap (map/get limits :day)))
(def turn-usd (unwrap (map/get limits :turn)))
(def system (str "You are " name ", " """
  a long-running agent living in whiff, the user's personal message
  daemon. The user, and services of theirs, leave you messages, which
  arrive as turns of one conversation, sometimes days apart. Answer
  briefly and plainly: your answer goes back to whoever wrote,
  the user's inbox or the service that asked, and a reply to it is the
  next message.
  """ "\n" (if (vector/empty? can) "" (str """
  Your tools are the whiff functions you may use: a :write one waits for
  the user's review, and another agent's ask for its answer. Don't wait
  for them: end your turn, and each result comes to you later as a
  message of its own.
  """ "\n")) prompt))

(def (read-file path) (string/trim (or-else (file/read-text path) "")))
(def (read-lines path) (string/lines (or-else (file/read-text path) "")))

; session is the conversation's id, made on its first turn.
(def (session)
  (match [(read-file session-file) (read-file started)]
    [["" ""]
     (let [id (uuid/new)]
       (do (try (file/write session-file id)) (ok id)))]
    [["" s] (ok s)] ; begun before there was a session file
    [[s _] (ok s)]))

; mcp is whiff mcp, for claude's --mcp-config: the tools of a turn with
; :can, which act in dir, or the agent's home.
(def mcp (json/to-string {:mcpServers {:whiff {:command "whiff" :args (if (= dir "") ["mcp"] ["mcp" "--dir" dir])}}}))

(def (claude id)
  (vector/concat ["claude" "-p" "--tools" "" "--append-system-prompt" system
                  "--output-format" "json" "--max-budget-usd" (float/to-string turn-usd)]
    (if (= model "") [] ["--model" model])
    (if (vector/empty? can) [] ["--mcp-config" mcp "--strict-mcp-config" "--allowedTools" "mcp__whiff"])
    (if (= (read-file started) id) ["--resume" id] ["--session-id" id])))

; busy? is whether the last turn runs: its message is in the inbox until
; the agent has its answer, after its job ends, unless it is an ask whose
; answer waits for the tasks the turn started. A turn from before turns
; kept their message runs while its job does.
(def (busy?)
  (match (vector/last (read-lines turns))
    [(none) #f]
    [(some last)
     (match [(asked last) (call :jobs/list)]
       [[(some [a _]) _] (and (not (vector/contains? (read-lines deferred) last))
                              (vector/any? (inbox) (fn ({:id i}) (= (int/to-string i) a))))]
       [[(none) (ok js)] (vector/any? js (fn ({:id i}) (= (int/to-string i) last)))]
       [_ #f])]))

; dollars is usd for people: $0.42.
(def (dollars usd) (str "$" (float/to-string (float/div (float/round (* usd 100.0)) 100.0))))

; spending are [time usd] for the turns of the last 24 hours.
(def (spending)
  (let [since (- (time/now) 1d)]
    (vector/filter
      (vector/map (read-lines costs)
        (fn (line)
          (match (string/split line " ")
            [[t c] (match [(time/from-string t) (float/from-string c)]
                     [[(ok at) (ok usd)] [at usd]]
                     [_ [since 0.0]])]
            [_ [since 0.0]])))
      (fn ([at _]) (> at since)))))

; spent is the dollars of the last 24 hours' turns.
(def (spent) (vector/reduce (spending) 0.0 (fn (sum [_ usd]) (+ sum usd))))

; spend keeps a turn's cost, and tells you once the day's budget is spent.
(def (spend usd)
  (let [before (spent)
        kept (vector/map (spending) (fn ([at c]) (str (time/to-string at) " " (float/to-string c) "\n")))
        _ (try (file/write costs (string/concat (vector/reduce kept "" string/concat) (time/to-string (time/now)) " " (float/to-string usd) "\n")))
        after (+ before usd)]
    (if (and (< before day-usd) (>= after day-usd))
      (call :me/tell (str name " has spent " (dollars after) " in the last 24 hours, its " (dollars day-usd)
                       " a day: it takes no more turns until it has spent less. (call :" name "/usage) says where it is."))
      (ok :done))))

; start starts a turn's job with text: (ok id), its id as text; (err
; {:kind :over-budget}) once the day's budget is spent.
(def (start text)
  (let [_ (try (over-budget))
        _ (try (file/mkdir home))
        opts {:stdin text :dir home :timeout (unwrap (map/get limits :time)) :origin :agent}
        id (int/to-string (try (submitted (call :jobs/run (claude (try (session)))
                                            (if (vector/empty? can) opts (map/set opts :session can))))))]
    (do (try (file/append turns (str id "\n")))
      (ok id))))

; over-budget is (err {:kind :over-budget}) once the day's budget is
; spent, else (ok :done).
(def (over-budget)
  (let [usd (spent)]
    (if (>= usd day-usd)
      (err {:kind :over-budget :outcome :not-started
            :message (str name " has spent " (dollars usd) " in the last 24 hours, its " (dollars day-usd) " a day")})
      (ok :done))))

; number is a JSON number as a float.
(def (number x) (if (= (value/type x) :int) (float/from-int x) x))

; outcome is what turn i's job result r answers: (ok text), or (err e)
; with :outcome. A turn's cost is kept, as what it spent is spent however
; it ended.
(def (outcome i r)
  (match r
    [(ok {:exit n :stdout out :stderr e})
     (match (json/parse out)
       [(ok res) when (= (map/get res :type) (some "result"))
        (let [usd (number (map/get-or res :total_cost_usd 0))
              _ (spend usd)
              why (string/join (map/get-or res :errors []) "; ")]
          (cond
            [(not (map/get-or res :is_error #f)) (ok (map/get-or res :result ""))]
            [(string/contains? why "already in use") ; as claude says it on stderr in text mode
             (err {:kind :exit :exit n :message (str "job " i " exited " (int/to-string n)) :stderr why})]
            [(= (map/get res :subtype) (some "error_max_budget_usd"))
             (err {:kind :over-budget :outcome :stopped :cost usd
                   :message (str "the turn reached its " (dollars turn-usd) " and stopped: " why)})]
            [_ (err {:kind :turn :outcome :stopped :cost usd :message (str "the turn failed: " why)})]))]
       [_ when (= n 0) (ok out)]
       [_ (err {:kind :exit :exit n :message (str "job " i " exited " (int/to-string n)) :stderr e})])]
    [(err e) (err e)]))

; begun marks the session begun, once a turn has run in it.
(def (begun) (try (file/write started (try (session)))))

; ask-turns are [turn message kind root] for each turn a message in the
; inbox began, ids as text and kind "ask", "tell", "wake" or
; "whiff/result". A result's root is the turn the task it tells of was
; started for, followed back through results; any other's is itself.
(def (ask-turns)
  (vector/reduce (read-lines asks) []
    (fn (all line)
      (match (string/split line " ")
        [[t a k r] (vector/append all [t a k r])]
        [[t a k] (vector/append all [t a k t])]
        [[t a] (vector/append all [t a "ask" t])] ; from before tells queued
        [_ all]))))

; asked is what turn id answers: (some [message kind]), or (none).
(def (asked id)
  (match (vector/find (ask-turns) (fn ([t _ _ _]) (= t id)))
    [(some [_ a k _]) (some [a k])]
    [(none) (none)]))

; root-of is turn id's root, as text: itself unless it was a result's.
(def (root-of id)
  (match (vector/find (ask-turns) (fn ([t _ _ _]) (= t id)))
    [(some [_ _ _ r]) r]
    [(none) id]))

; turn-of is the turn that started task id, an int, as text: the last
; before it, as whiff numbers tasks and jobs alike, and the agent's
; session lasts a turn. "" for one from before its first turn.
(def (turn-of id)
  (vector/reduce (read-lines turns) ""
    (fn (last t)
      (match (int/from-string t)
        [(ok n) when (< n id) t]
        [_ last]))))

; open-for are the tasks that haven't ended which were started for root,
; a turn: by it, or by the turns of their results.
(def (open-for root)
  (vector/filter (or-else (session/tasks) [])
    (fn (t) (= (root-of (turn-of t)) root))))

; waits? is whether ask a is still in the inbox, its answer to come.
(def (waits? a) (vector/any? (inbox) (fn ({:id i}) (= (int/to-string i) a))))

(def wake-text (str "This is your scheduled turn; you have one every " (value/to-string every)
                 ". Look again at what the user asked you to keep track of. If there is nothing worth telling them, answer only: nothing"))

; result-text is a turn's text for task t, which an earlier turn of the
; agent's started, for root, and which ended with r. For an ask that
; waits, the answer is the ask's, once nothing else started for it runs.
(def (result-text t r root)
  (let [ended (str "Task " (int/to-string t) ", which you started in an earlier turn, has ended: " (value/to-string r) ". ")
        others (vector/filter (open-for root) (fn (o) (not (= o t))))]
    (match (asked root)
      [(some [a "ask"]) when (and (waits? a) (vector/empty? others))
       (str ended "Carry on with what it was for: your answer now goes to whoever asked you, as your answer to their message.")]
      [(some [a "ask"]) when (waits? a)
       (str ended "Tasks " (string/join (vector/map others int/to-string) ", ")
         " you started for the same message haven't ended: you'll answer once they have. For now answer only: nothing")]
      [_ (str ended "Carry on with what it was for. If the user should hear of it, say so in your answer; otherwise answer only: nothing")])))

; paused? is whether you paused the agent: its messages wait.
(def (paused?) (= (read-file paused-file) "paused"))

; next-ask starts a turn for the oldest message in the inbox, a tell, an
; ask, a wake or a result, that hasn't one, unless a turn is running or
; the agent is paused: (ok :waiting), (ok :paused), (ok :idle) or (ok
; :thinking). One whose turn can't start, as the review
; gate or the day's budget refuses it, is answered with why: (ok
; :refused). A wake sets the next as it leaves the queue. whiff tells the
; agent of its messages again as each turn ends, each in its own sender's
; chain, which a turn's own must be.
(def (next-ask)
  (let [taken (ask-turns)
        waiting (vector/filter (inbox)
                  (fn ({:id i}) (not (vector/any? taken (fn ([_ a _ _]) (= a (int/to-string i)))))))]
    (match (vector/first waiting)
      [(none) (ok :idle)]
      [_ when (paused?) (ok :paused)]
      [_ when (busy?) (ok :waiting)]
      [(some {:id i :fn f :args args})
       (let [_ (if (= f :wake) (send-after every :wake) (ok :done))
             root (match [f args] [[:whiff/result [t _]] (root-of (turn-of t))] [_ ""])
             text (match [f args]
                    [[:whiff/result [t r]] (result-text t r root)]
                    [[_ [t]] t]
                    [_ wake-text])]
         (match (start text)
           [(ok t) (do (try (file/append asks (str t " " (int/to-string i) " " (keyword/name f) (if (= root "") "" (str " " root)) "\n")))
                     (ok :thinking))]
           [(err e) (do (reply i (err e)) (ok :refused))]))])))

; reply-ask answers ask i with an ask turn's result r.
(def (reply-ask i r)
  (match r
    [(ok answer) (do (begun) (reply i (ok (string/trim answer))))]
    [(err {:kind :exit :stderr e}) when (string/contains? e "already in use")
     (do (begun) (reply i (err {:kind :session :outcome :not-started :message "the session had already begun, so the message was lost; ask again"})))]
    [(err e) (reply i (err e))]))

; finished answers message a, of kind, with turn's outcome o: an ask's
; sender gets the answer, once the tasks the turn started have ended; a
; tell's answer goes to your inbox and its sender hears it was told; a
; wake's, if it has news, to your inbox. A result's answers the ask it
; was for, if that waits and nothing else started for it runs; else, if
; it has news, it goes to your inbox.
(def (finished turn a kind o)
  (let [i (unwrap (int/from-string a))]
    (match kind
      ["ask" when (match o [(ok _) (not (vector/empty? (open-for turn)))] [_ #f])
       (do (begun) (try (file/append deferred (str turn "\n"))) (ok :deferred))]
      ["ask" (reply-ask i o)]
      ["whiff/result"
       (let [root (root-of turn)]
         (match (asked root)
           [(some [ra "ask"]) when (waits? ra)
            (if (vector/empty? (open-for root))
              (let [_ (reply-ask (unwrap (int/from-string ra)) o)] (reply i (ok :done)))
              (do (begun) (reply i (ok :done))))]
           [_ (let [_ (answered o #t)] (reply i (ok :done)))]))]
      ; answered's is your inbox's pending: what the sender hears is reply's.
      ["tell" (let [_ (answered o #f)] (reply i (match o [(ok _) (ok :told)] [e e])))]
      [_ (let [_ (answered o #t)] (reply i (ok :done)))])))

; answered leaves a turn's answer in your inbox; a scheduled turn's
; "nothing" stays out of it.
(def (answered r wake)
  (match r
    [(ok answer) when (and wake (= (string/lower (string/trim answer)) "nothing"))
     (do (begun) (ok :done))]
    [(ok answer) (do (begun) (call :me/tell (string/trim answer)))]
    [(err {:kind :exit :stderr e}) when (string/contains? e "already in use")
     (do (begun)
       (call :me/tell "My session had already begun, so that message was lost; please send it again."))]
    [(err e) (call :me/tell (string/concat "I couldn't answer: " (value/to-string e)))]))

(ask (tell text)
  "Leaves the agent a message: pending at once, its answer in your inbox, and (ok :told) for the sender when its turn ends. Messages wait their turn, oldest first.")

(ask (ask text)
  "Asks the agent: pending at once, and [:whiff/done id (ok answer)] when its turn ends, or (err e) with :outcome. Asks wait their turn, oldest first.")

(on (whiff/asked id)
  "A message waits in the inbox: its turn starts now, unless another is running. whiff's own; ask or tell the agent instead."
  (next-ask))

(on (usage) :read
  "What the agent spent: {:spent usd :turns n :day usd}, the dollars and turns of the last 24 hours, and its :day limit."
  (ok {:spent (spent) :turns (vector/length (spending)) :day day-usd}))

(on (stop)
  "Stops the turn running now: its job is cancelled, and whoever it answers hears (err {:kind :cancelled}). (ok :idle) if none runs."
  (match (vector/last (read-lines turns))
    [(some last) when (busy?) (call :jobs/cancel (unwrap (int/from-string last)))]
    [_ (ok :idle)]))

(on (pause)
  "Pauses the agent: it takes no more turns, and messages wait in its inbox until you resume it; a turn running now ends as it would. Scheduled wakes don't pile up: the next is set as one is taken."
  (do (try (file/mkdir home))
    (try (file/write paused-file "paused"))
    (ok :paused)))

(on (resume)
  "Resumes a paused agent: it takes what waits in its inbox, oldest first. (ok :thinking), or (ok :idle) if nothing waits."
  (do (try (file/write paused-file ""))
    (next-ask)))

(on (forget)
  "Ends the conversation: the next message starts a new one, which remembers nothing."
  (do (try (file/write session-file ""))
    (try (file/write started ""))
    (ok :forgotten)))

(ask (whiff/result id r)
  "A task one of the agent's turns started, as a call to a :write function or another agent's ask, ended with r: it waits its turn, and the turn answers only with news. whiff's own.")

(ask (wake)
  "A scheduled turn, which whiff sends every :every and which waits its turn: it answers only if there's something to tell you. whiff's own loop: tell the agent instead.")

(on (whiff/done id r)
  "A turn's answer goes to whoever asked, or to your inbox for a tell; your reply to that, if it is text, is the next message."
  (let [i (int/to-string id)]
    (cond
      [(vector/contains? (read-lines turns) i)
       (let [o (outcome i r)]
         (match (asked i)
           [(some [a k]) (finished i a k o)]
           [(none) (answered o #f)]))] ; a turn from before tells queued
      ; Your reply to an answer is a tell, which waits its turn.
      [_ (match r
           [(ok text) when (= (value/type text) :string) (send :tell text)]
           [_ (ok :done)])])))
