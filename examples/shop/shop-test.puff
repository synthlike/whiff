; shop-test: an integration test of the shop in examples/shop, which procs
; runs (see docs/procs.md). run brings the shop up, waits until every one of
; its processes is ready, then runs check.puff's cases against the API and
; tells you how it went, in your inbox and on :shop-test/done.
;   whiff call shop-test/run
;   whiff inbox
;   whiff sub shop-test/done
;
; Its state is only whether it waits for the shop to be ready.

(service shop-test :state {:waiting #f}
  (use "check.puff")

  (def api "http://localhost:8080")
  (def stack :shop) ; the project in procs.puff
  (def project (keyword/name stack))

  ; ready? is whether every process of the project in runs, as procs/runs
  ; gives them, is running and ready.
  (def (ready? runs)
    (vector/all? (vector/filter runs (fn ({:proc p}) (string/starts-with? (keyword/name p) (str project "/"))))
      (fn ({:status s}) (= s :running))))

  (test "the shop is ready once each of its processes runs"
    (= [(ready? [{:proc :shop/db :status :running} {:proc :shop/api :status :starting} {:proc :blog/x :status :down}])
        (ready? [{:proc :shop/db :status :running} {:proc :shop/api :status :running} {:proc :blog/x :status :down}])]
      [#f #t]))

  (def (shop-ready?) (match (call :procs/runs) [(ok rs) (ready? rs)] [_ #f]))

  ; report tells you how results went, offering to run it again or see the
  ; API's output, and says so on :shop-test/done.
  (def (report results)
    (let [passed (vector/all? results (fn ({:pass p}) p))]
      (do (publish :shop-test/done {:passed passed :results results})
        (or-else (call :me/tell (str "shop-test: " (summary results))
                   {:actions [{:label "Run again" :action [:shop-test/run]}
                              {:label "Logs of shop/api" :action [:procs/logs :shop/api]}]})
          :told))))

  (on (run state) :write :update
    "Brings the shop up with procs and tries its API once every process is ready: (ok results) if it is ready already, else (ok :waiting); either way you hear how it went in your inbox, and on :shop-test/done."
    (let [_ (try (call :procs/up stack))]
      (if (shop-ready?)
        (let [results (check api)]
          (do (report results) (ok [results (map/set state :waiting #f)])))
        (ok [:waiting (map/set state :waiting #t)]))))

  ; A process is ready: once all of the shop is, and run waits, it runs.
  (on :procs/ready (state v) :update
    (if (and (map/get-or state :waiting #f) (shop-ready?))
      (do (report (check api)) (ok (map/set state :waiting #f)))
      (ok state))))
