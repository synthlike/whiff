; check: a test of the shop's API in plain puff, no whiff needed:
;   puff examples/shop/check.puff                        ; http://localhost:8080
;   puff examples/shop/check.puff http://localhost:9090  ; or another
;   puff -t examples/shop/check.puff                     ; its helpers' tests
; It prints a line per case and exits 0 if each passed, 1 if not.
; shop-test.puff uses this file, to run the same cases from whiff.
;
; The cases are data, checked by lib/http-check.puff: a request, [method
; path body], and what the response must have: a :status, its :text, or
; fields of its :json, at any depth. A case can :save a field of the JSON
; it got, and a later case's path can be a function of what was saved:
; read back the order just made.

(use "lib/http-check.puff")

(def cases
  [{:name "it is healthy" :req [:get "/health"] :want {:status 200 :text "ok\n"}}
   {:name "an order is made" :req [:post "/orders" {:item "tea" :qty 2}]
    :want {:status 201 :json {:item "tea" :qty 2}} :save :id}
   {:name "it reads back" :req [:get (fn (saved) (str "/orders/" (map/get-or saved :id 0)))]
    :want {:status 200 :json {:item "tea" :qty 2}}}
   {:name "an order nobody made is 404" :req [:get "/orders/999999"] :want {:status 404}}
   {:name "an empty order is refused" :req [:post "/orders" {:item "" :qty 0}] :want {:status 400}}])

; rising is whether five new orders get ids that only go up: no two alike,
; none reused.
(def (rising base)
  (let [ids (vector/map (vector/range 0 5)
              (fn (_) (match (request base [:post "/orders" {:item "x" :qty 1}] {}) [(ok {:json {:id id}}) id] [_ 0])))]
    (result "five orders get rising ids"
      (vector/all? (vector/range 1 5) (fn (i) (< (unwrap (vector/get ids (- i 1))) (unwrap (vector/get ids i)))))
      (ok ids))))

; check is the results of the cases and rising against base.
(def (check base) (vector/append (run-cases base cases) (rising base)))

(def (main args)
  (let [base (match args [[b] b] [_ "http://localhost:8080"])
        results (check base)
        failed (vector/filter results (fn ({:pass p}) (not p)))]
    (do (io/println (string/join (vector/map results line) "\n"))
      (if (vector/empty? failed)
        (ok (vector/length results))
        (err {:kind :failed :message (str (vector/length failed) " of " (vector/length results) " cases failed")})))))
