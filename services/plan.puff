; plan: a goal, planned by Claude and built by pipelines. A planner Claude,
; which can read the repository but not change it, splits the goal into a
; few ordered tasks; each task is a :pipeline run (a dev Claude, your check
; and a reviewer Claude), started from the branch of the one before, so
; the last run's branch holds the whole goal. A run that doesn't end ready
; stops the plan, until you retry it with a note for the developer. How it
; went lands in your inbox, with what you can do about it. Needs git, the
; claude CLI and services/pipeline.puff.
;   whiff call plan/start "a todo CLI: add, list and done, kept in todo.json" '["go" "test" "./..."]'
;   whiff call plan/draft "..." '["go" "test" "./..."]'   ; the same, but waits for you
;   whiff call plan/edit 3 2 "store todos in a map"        ; a drafted plan's task 2
;   whiff call plan/approve 3      ; build a drafted plan's tasks
;   whiff call plan/retry 1 "store todos in a map"   ; after a task's run gave up
;   whiff call plan/review-again 1  ; after a task's reviewer failed
;   whiff call plan/merge 1        ; once done: its last branch, fast-forward only
;   whiff call plan/discard 2      ; or throw its runs away, worktrees and branches
;   whiff call plan/plans          ; each plan, its tasks and where it is
;   whiff call plan/board          ; the same as a board: pick a ticket to cancel or show it
;   whiff sub plan/changed         ; {:plan n} when its tickets move
;   whiff sub pipeline/done        ; each task's run as it ends

(service plan :state {:next 1 :plans {} :jobs {} :runs {}}
  (def most 4) ; tasks a plan may have

  (def prompt """
    You are the planner of a small pipeline. Read the repository you are in,
    then split the goal below into at most 4 tasks, in the order to build
    them. Each task is done by a developer in one sitting and reviewed on its
    own, so make each one small, complete and testable, and say in it what to
    test. Answer with only a JSON array of strings, one per task, and nothing
    else.
    """)

  (def (plan-of state n) (unwrap (map/get-in state [:plans n])))

  (def (set-plan state n m)
    (map/update-in state [:plans n] (fn (p) (map/merge p m))))

  (def (strings? v) (vector/all? v (fn (x) (= (value/type x) :string))))

  ; tasks reads the planner's answer: the JSON array in it, even inside a
  ; code fence, as (ok tasks), at most most of them.
  (def (tasks text)
    (let [from (or-else (string/index text "[") 0)
          json (match (string/split (string/slice text from) "\n```") [[j & _] j])
          ts (try (json/parse (string/trim json)))]
      (match ts
        [[] (err {:kind :no-tasks :message "the planner gave no tasks"})]
        [[& _] when (strings? ts) (ok (vector/slice ts 0 (min most (vector/length ts))))]
        [_ (err {:kind :bad-plan :message (str "want a JSON array of tasks, got " text)})])))

  (test "tasks inside a code fence"
    (= (tasks "Here is the plan:\n```json\n[\"a\", \"b\"]\n```\n") (ok ["a" "b"])))

  (test "at most 4 tasks"
    (= (tasks "[\"1\", \"2\", \"3\", \"4\", \"5\"]") (ok ["1" "2" "3" "4"])))

  (test "an answer that isn't a plan"
    (= (vector/map [(tasks "[]") (tasks "[1, 2]") (tasks "no")] (fn (r) (match r [(err {:kind k}) k])))
      [:no-tasks :bad-plan :parse]))

  ; next-run starts plan n's task i from base, a commit or branch; :built
  ; is each task's run so far.
  (def (next-run state n i base)
    (let [{:repo repo :tasks ts :check check} (plan-of state n)
          task (unwrap (vector/get ts i))
          run (try (call :pipeline/start-on repo base task check))
          built (map/get-or (plan-of state n) :built [])]
      (ok (-> state
            (set-plan n {:step :building :task i :run run :built (vector/append built run)})
            (map/set-in [:runs run] n)))))

  ; finish ends plan n as status, telling you how it went, with actions,
  ; what you can do about it, which it keeps for no-plan.
  (def (finish state n status note actions)
    (let [{:goal goal} (plan-of state n)]
      (do (or-else (call :me/tell (str "plan " n ", " goal ": " (keyword/name status) ". " note) {:actions actions}) :told)
        (ok (set-plan state n {:step status :actions actions})))))

  ; no-plan is (err {:kind :no-plan}) for an action plan n doesn't take
  ; now, saying why, with :actions, the ones it does: those it offered as
  ; it stopped, or its board while it plans or builds.
  (def (no-plan state n why)
    (err {:kind :no-plan :message why
          :actions (match (map/get-in state [:plans n])
                     [(some p) when (vector/contains? [:proposed :done :failed] (map/get-or p :step :none)) (map/get-or p :actions [])]
                     [(some {:step s}) when (vector/contains? [:planning :building] s) [{:label "Show the board" :action [:plan/board]}]]
                     [_ []])}))

  (test "an action a plan doesn't take offers the ones it does"
    (= [(no-plan {:plans {1 {:step :done :actions [{:label "Merge whiff/2" :action [:plan/merge 1]}]}}} 1 "done")
        (no-plan {:plans {2 {:step :building}}} 2 "building")
        (no-plan {:plans {}} 3 "none")]
      [(err {:kind :no-plan :message "done" :actions [{:label "Merge whiff/2" :action [:plan/merge 1]}]})
       (err {:kind :no-plan :message "building" :actions [{:label "Show the board" :action [:plan/board]}]})
       (err {:kind :no-plan :message "none" :actions []})]))

  (def (show-action run) {:label "Show review and diff" :action [:pipeline/show run]})

  (def (merge-action n branch) {:label (str "Merge " branch) :action [:plan/merge n]})

  (def (retry-action n) {:label "Retry with a note" :action [:plan/retry n] :ask "A note for the developer, if any"})

  (def (discard-action n) {:label "Discard" :action [:plan/discard n]})

  ; stopped-actions are what plan n offers once the run of its task, run,
  ; ended as status at step from: one whose reviewer failed can be reviewed
  ; again, as Retry would rerun the dev.
  (def (stopped-actions n run status from)
    (vector/concat [(show-action run)]
      (if (and (= status :failed) (= from :review)) [{:label "Review again" :action [:plan/review-again n]}] [])
      [(retry-action n) (discard-action n)]))

  (def (approve-action n) {:label "Build it" :action [:plan/approve n]})

  (def (edit-action n i) {:label "Edit" :action [:plan/edit n i] :ask "The task, as it should be"})

  ; propose stops plan n at its tasks, for you to edit and approve.
  (def (propose state n)
    (let [{:tasks ts} (plan-of state n)
          listed (vector/map (vector/range 0 (vector/length ts)) (fn (i) (str (+ i 1) ". " (unwrap (vector/get ts i)))))]
      (finish state n :proposed (str "Its tasks:\n\n" (string/join listed "\n"))
        [(approve-action n) (discard-action n)])))

  ; moved is r, once :plan/changed says plan n's tickets moved, so a client
  ; showing the board fetches it again.
  (def (moved n r)
    (do (publish :plan/changed {:plan n})
      r))

  ; begin plans goal with check as plan n, (ok [n state]); a draft waits
  ; for your approval once planned.
  (def (begin state goal check draft)
    (let [repo (string/trim (try (proc/output ["git" "rev-parse" "--show-toplevel"])))
          base (string/trim (try (proc/output ["git" "-C" repo "rev-parse" "HEAD"])))
          n (map/get-or state :next 1)
          id (try (submitted (call :jobs/run ["claude" "-p" "--strict-mcp-config" "--tools" "Read,Glob,Grep" "--no-session-persistence"]
                               {:stdin (str prompt "\n\nGoal: " goal) :dir repo :as :text :timeout 10m})))]
      (moved n (ok [n (-> state
                        (map/set :next (+ n 1))
                        (map/set-in [:plans n] {:goal goal :repo repo :base base :check check :step :planning :tasks [] :draft draft})
                        (map/set-in [:jobs id] n))]))))

  (on (start state goal check) :write :update
    "Plans goal in the repository here with a planner Claude, then builds its tasks one after another as :pipeline runs, each from the last one's branch, with check (a command, like [\"go\" \"test\" \"./...\"]). (ok n), the plan's number; how it went lands in your inbox."
    (begin state goal check #f))

  (on (draft state goal check) :write :update
    "Plans goal as start does, then waits for you: its tasks land in your inbox, edit changes one, and approve builds them. (ok n), the plan's number."
    (begin state goal check #t))

  (on (plans state) :read
    "Every plan, oldest first: {:plan :goal :step :tasks :task :run}, with :step one of :planning, :proposed, :building, :done, :failed, :merged or :discarded, and :task the index of the task :run builds; :built is each task's run so far."
    (ok (vector/map (map/entries (map/get-or state :plans {}))
          (fn ([n p]) (map/set p :plan n)))))

  ; columns are the board's, each the steps of the tickets in it.
  (def columns
    [["Planned" [:planning :planned]] ["Dev" [:starting :dev]] ["Check" [:check]]
     ["Review" [:review]] ["Done" [:ready]] ["Failed" [:failed :gave-up :cancelled :skipped]]])

  ; tickets is plan n's, p, as {:step :item}s: one per task, at its run's
  ; step from runs, :pipeline/runs's answer, or :planned, or :skipped once
  ; the plan has ended; or one for the goal while it has no tasks. The
  ; task a failed plan stopped at can be retried or discarded, and a done
  ; plan's last task merged.
  (def (tickets n p runs)
    (let [{:goal goal :step step :tasks ts} p
          built (map/get-or p :built [])
          stopped (if (= step :failed) (map/get-or p :task -1) -1)
          total (vector/length ts)]
      (if (= total 0)
        [{:step step :item {:label goal :detail (str "plan " n ", " (keyword/name step))}}]
        (vector/map (vector/range 0 total)
          (fn (i)
            (let [task (unwrap (vector/get ts i))
                  where (str "plan " n ", task " (+ i 1) " of " total)
                  run (match (vector/get built i)
                        [(some r) (vector/find runs (fn ({:run x}) (= x r)))]
                        [_ (none)])]
              (match run
                [(some rn)
                 (let [{:run r :step s :round rd :branch b} rn]
                   {:step s :item {:label task :detail (str where ", round " rd ", " b)
                                   :actions (cond
                                              [(vector/contains? [:dev :check :review] s)
                                               [(show-action r) {:label "Cancel the run" :action [:pipeline/cancel r]}]]
                                              [(and (= i stopped) (vector/contains? [:gave-up :failed :cancelled] s))
                                               (stopped-actions n r s (map/get-or rn :from :none))]
                                              [(and (= step :done) (= i (- total 1))) [(show-action r) (merge-action n b)]]
                                              [_ [(show-action r)]])}})]
                [_ (if (= step :proposed)
                     ; A drafted plan's tasks can be edited; the first ticket
                     ; builds or discards it.
                     {:step :planned :item {:label task :detail where
                                            :actions (vector/concat [(edit-action n (+ i 1))]
                                                       (if (= i 0) [(approve-action n) (discard-action n)] []))}}
                     {:step (if (= step :building) :planned :skipped) :item {:label task :detail where}})])))))))

  (test "a ticket per task, at its run's step"
    (= (tickets 1 {:goal "g" :step :building :tasks ["a" "b"] :built [7]}
         [{:run 7 :step :review :round 2 :branch "whiff/7"}])
      [{:step :review :item {:label "a" :detail "plan 1, task 1 of 2, round 2, whiff/7"
                             :actions [{:label "Show review and diff" :action [:pipeline/show 7]}
                                       {:label "Cancel the run" :action [:pipeline/cancel 7]}]}}
       {:step :planned :item {:label "b" :detail "plan 1, task 2 of 2"}}]))

  (test "a failed plan's task can be retried or discarded"
    (= (tickets 4 {:goal "g" :step :failed :task 0 :tasks ["a"] :built [5]} [{:run 5 :step :gave-up :round 3 :branch "whiff/5"}])
      [{:step :gave-up :item {:label "a" :detail "plan 4, task 1 of 1, round 3, whiff/5"
                              :actions [{:label "Show review and diff" :action [:pipeline/show 5]}
                                        {:label "Retry with a note" :action [:plan/retry 4] :ask "A note for the developer, if any"}
                                        {:label "Discard" :action [:plan/discard 4]}]}}]))

  (test "a task whose reviewer failed can be reviewed again"
    (= (match (tickets 4 {:goal "g" :step :failed :task 0 :tasks ["a"] :built [5]} [{:run 5 :step :failed :from :review :round 1 :branch "whiff/5"}])
         [[{:item {:actions as}}] (vector/map as (fn ({:label l}) l))])
      ["Show review and diff" "Review again" "Retry with a note" "Discard"]))

  (test "a done plan's last task can be merged"
    (= (vector/map (tickets 5 {:goal "g" :step :done :task 1 :tasks ["a" "b"] :built [6 7]}
                     [{:run 6 :step :ready :round 1 :branch "whiff/6"} {:run 7 :step :ready :round 1 :branch "whiff/7"}])
         (fn ({:item {:actions as}}) (vector/length as)))
      [1 2]))

  (test "a drafted plan's tasks can be edited, and it built or discarded"
    (= (tickets 6 {:goal "g" :step :proposed :tasks ["a" "b"]} [])
      [{:step :planned :item {:label "a" :detail "plan 6, task 1 of 2"
                              :actions [{:label "Edit" :action [:plan/edit 6 1] :ask "The task, as it should be"}
                                        {:label "Build it" :action [:plan/approve 6]}
                                        {:label "Discard" :action [:plan/discard 6]}]}}
       {:step :planned :item {:label "b" :detail "plan 6, task 2 of 2"
                              :actions [{:label "Edit" :action [:plan/edit 6 2] :ask "The task, as it should be"}]}}]))

  (test "the goal while it has no tasks, and the tasks a failed plan didn't start"
    (= [(tickets 2 {:goal "g" :step :planning :tasks []} [])
        (vector/map (tickets 3 {:goal "g" :step :failed :tasks ["a" "b"] :built [4]} [{:run 4 :step :gave-up :round 3 :branch "whiff/4"}])
          (fn ({:step s}) s))]
      [[{:step :planning :item {:label "g" :detail "plan 2, planning"}}] [:gave-up :skipped]]))

  (on (board state) :read
    "Every plan's tasks as a board, a ticket each in a column by where it is: Planned, Dev, Check, Review, Done or Failed; a merged or discarded plan has left it. A ticket with a run shows its last review and diff, and cancels it while it runs."
    (let [runs (try (call :pipeline/runs))
          ts (vector/reduce (map/entries (map/get-or state :plans {})) []
               (fn (acc [n p])
                 (if (vector/contains? [:merged :discarded] (map/get-or p :step :none))
                   acc
                   (vector/concat acc (tickets n p runs)))))]
      (ok (view/board (vector/map columns
                        (fn ([title steps])
                          {:title title
                           :items (vector/map (vector/filter ts (fn ({:step s}) (vector/contains? steps s))) (fn ({:item it}) it))}))
            {:changed :plan/changed}))))

  ; The planner's answer: the tasks, and the first one's run.
  (on (whiff/done state id r) :update
    "The planner is done: its tasks, and the first one's run."
    (match (map/get-in state [:jobs id])
      [(none) (ok state)]
      [(some n)
       (let [state (map/update state :jobs (fn (js) (map/delete js id)))
             {:base base} (plan-of state n)
             step (match r
                    [(ok text) (match (tasks text)
                                 [(ok ts) (if (map/get-or (plan-of state n) :draft #f)
                                            (propose (set-plan state n {:tasks ts}) n)
                                            (next-run (set-plan state n {:tasks ts}) n 0 base))]
                                 [e e])]
                    [e e])]
         (moved n (catch step
                    [e (ok (or-else (finish state n :failed (str "The planner failed: " (value/to-string e)) [(discard-action n)]) state))])))]))

  ; A run of a plan took a step: its ticket moved.
  (on :pipeline/step (state v) :update
    (match v
      [{:run run}
       (match (map/get-in state [:runs run])
         [(some n) (moved n (ok state))]
         [(none) (ok state)])]
      [_ (ok state)]))

  ; A run of a plan ended: the next task from its branch, or the plan ends.
  (on :pipeline/done (state v) :update
    (match v
      [{:run run :status status :branch branch :note note}
       (match (map/get-in state [:runs run])
         [(none) (ok state)]
         [(some n)
          (let [state (map/update state :runs (fn (rs) (map/delete rs run)))
                {:tasks ts :task i} (plan-of state n)
                last (= (+ i 1) (vector/length ts))]
            (moved n
              (cond
                [(not (= status :ready))
                 (finish state n :failed (str "Task " (+ i 1) " of " (vector/length ts) " ended " (keyword/name status) ": " note)
                   (stopped-actions n run status (map/get-or v :from :none)))]
                [last
                 (finish state n :done (str "All " (vector/length ts) " tasks built; " branch " has them all.")
                   [(show-action run) (merge-action n branch)])]
                [_
                 (catch (next-run state n (+ i 1) branch)
                   [e (finish state n :failed (str "Task " (+ i 2) " didn't start: " (value/to-string e)) [(discard-action n)])])])))])]))

  (on (merge state n) :write :update
    "Merges done plan n's last branch, which holds every task, into the branch checked out in its repository, only as a fast-forward, as :pipeline/merge does, then removes every run's worktree and branch; it leaves the board. (ok branch); (err {:kind :no-plan}) unless plan n is done."
    (match (map/get-in state [:plans n])
      [(some {:step :done :run run :built built})
       (let [b (try (call :pipeline/merge run))
             ; The earlier runs' branches are in the last one: merging them
             ; only tidies them away.
             _ (vector/each (vector/filter built (fn (r) (not (= r run))))
                 (fn (r) (ok (or-else (call :pipeline/merge r) ""))))]
         (moved n (ok [b (set-plan state n {:step :merged})])))]
      [_ (no-plan state n (str "plan " n " isn't done: nothing to merge"))]))

  (on (discard state n) :write :update
    "Discards plan n, done or failed: every run it built, worktrees, uncommitted work and branches, as :pipeline/discard does; it leaves the board. (ok :discarded); (err {:kind :no-plan}) unless plan n is done or failed."
    (match (map/get-in state [:plans n])
      [(some p) when (vector/contains? [:proposed :done :failed] (map/get-or p :step :none))
       (let [_ (vector/each (map/get-or p :built [])
                 (fn (r) (ok (or-else (call :pipeline/discard r) ""))))]
         (moved n (ok [:discarded (set-plan state n {:step :discarded})])))]
      [_ (no-plan state n (str "plan " n " isn't done or failed: nothing to discard"))]))

  (on (approve state n) :write :update
    "Builds drafted plan n's tasks, as they are now, as start does. (ok :building); (err {:kind :no-plan}) unless plan n waits for approval."
    (match (map/get-in state [:plans n])
      [(some {:step :proposed :base base})
       (moved n (ok [:building (try (next-run state n 0 base))]))]
      [_ (no-plan state n (str "plan " n " doesn't wait for approval"))]))

  (on (edit state n i task) :write :update
    "Sets task i, from 1, of drafted plan n to task, a string. (ok tasks); (err {:kind :no-plan}) unless plan n waits for approval, (err {:kind :no-task}) unless it has task i."
    (match (map/get-in state [:plans n])
      [(some {:step :proposed :tasks ts})
       (cond
         [(not (= (value/type task) :string)) (err {:kind :bad-task :message "want the task as a string"})]
         [(= (string/trim task) "") (err {:kind :bad-task :message "the task is empty"})]
         [(not (and (= (value/type i) :int) (>= i 1) (<= i (vector/length ts))))
          (err {:kind :no-task :message (str "plan " n " has tasks 1 to " (vector/length ts))})]
         [_ (let [ts (vector/set ts (- i 1) task)]
              (moved n (ok [ts (set-plan state n {:tasks ts})])))])]
      [_ (no-plan state n (str "plan " n " doesn't wait for approval"))]))

  (on (retry state n note) :write :update
    "Takes plan n on after the run of the task it stopped at gave up, failed or was cancelled: its dev Claude gets note, your words for it (\"\" for none), and up to 3 more rounds, and the plan goes on from there. (ok :retrying); (err {:kind :no-plan}) unless plan n stopped so."
    (match (map/get-in state [:plans n])
      [(some {:step :failed :run run})
       (let [_ (try (call :pipeline/retry run note))]
         (moved n (ok [:retrying (-> state (set-plan n {:step :building}) (map/set-in [:runs run] n))])))]
      [_ (no-plan state n (str "plan " n " didn't stop at a task's run: nothing to retry"))]))

  (on (review-again state n) :write :update
    "Takes plan n on after the reviewer of the task it stopped at failed, as by a timeout: only the reviewer runs again, as :pipeline/review-again does, and the plan goes on from there. (ok :reviewing); (err {:kind :no-plan}) unless plan n stopped at a task's run, and :pipeline/review-again's (err {:kind :no-run}) unless its reviewer failed."
    (match (map/get-in state [:plans n])
      [(some {:step :failed :run run})
       (let [_ (try (call :pipeline/review-again run))]
         (moved n (ok [:reviewing (-> state (set-plan n {:step :building}) (map/set-in [:runs run] n))])))]
      [_ (no-plan state n (str "plan " n " didn't stop at a task's run: nothing to review again"))])))
