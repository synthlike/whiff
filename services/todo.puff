; todo: the checkbox items in TODO.md, in the caller's directory. The file
; is its state, so editing it by hand is fine.
;   whiff call todo/open
;   whiff call todo/add "write the docs"
;   whiff call todo/done 12
;   whiff call todo/view | fzf | whiff act   ; pick an open item to tick

(service todo
  (def file "TODO.md")

  ; An item is "- [ ] text" or "* [x] text", at any indent. Lines indented
  ; under it, up to a blank line, continue its text.
  (def item-re "^\\s*[-*] \\[([ xX])\\] (.*)$")
  (def heading-re "^#+\\s+(.*)$")

  ; continue adds line to the text of the last item.
  (def (continue items line)
    (let [i (- (vector/length items) 1)]
      (vector/set items i
        (map/update (unwrap (vector/get items i)) :text (fn (t) (string/concat t " " (string/trim line)))))))

  ; step reads the next line into st: {:n :section :items :in-item}.
  (def (step st line)
    (let [{:n n :section section :items items :in-item in-item} st
          n (+ n 1)
          next (map/set st :n n)]
      (match [(regex/groups line item-re) (regex/groups line heading-re)]
        [[(some [mark text]) _]
         (map/merge next {:in-item #t :items (vector/append items
           {:line n :done (not (= mark " ")) :text (string/trim text) :section section})})]
        [[_ (some [h])] (map/merge next {:in-item #f :section (string/trim h)})]
        [_ when (and in-item (string/starts-with? line "  ") (not (= (string/trim line) "")))
         (map/set next :items (continue items line))]
        [_ (map/set next :in-item #f)])))

  (def (parse text)
    (let [{:items items} (vector/reduce (string/lines text) {:n 0 :section "" :items [] :in-item #f} step)]
      items))

  (test "items, their sections and continued lines"
    (= (parse "# Now\n- [ ] a\n  more\n\n* [x] b\n  - [X] c\nnot an item\n")
       [{:line 2 :done #f :text "a more" :section "Now"}
        {:line 5 :done #t :text "b" :section "Now"}
        {:line 6 :done #t :text "c" :section "Now"}]))

  (def (read) (file/read-text file))

  ; append is old, the file's text, with a new item for text at the end.
  (def (append old text)
    (let [sep (if (or (= old "") (string/ends-with? old "\n")) "" "\n")]
      (string/concat old sep "- [ ] " (string/trim text) "\n")))

  (test "append starts a line when the file doesn't end in one"
    (= [(append "- [ ] a" " b ") (append "" "c")] ["- [ ] a\n- [ ] b\n" "- [ ] c\n"]))

  (def (write-new new)
    (do (try (file/write-atomic file new))
        (ok (vector/length (string/lines new)))))

  (on (items)
    "Every item in TODO.md, in order: {:line :done :text :section}, where :line counts from 1 and :section is the heading it is under, \"\" before any."
    (ok (parse (try (read)))))

  (on (open)
    "The items not done yet, as items gives them."
    (ok (vector/filter (parse (try (read))) (fn ({:done d}) (not d)))))

  (on (view)
    "The open items as a view: picking one ticks it."
    (ok (view/items (vector/map (vector/filter (parse (try (read))) (fn ({:done d}) (not d)))
      (fn ({:line l :text t :section s})
        {:label t :detail (if (= s "") (str file ":" l) (str file ":" l "  " s)) :action [:todo/done l]})))))

  (on (add text)
    "Adds \"- [ ] text\" at the end of TODO.md, creating the file if there isn't one; (ok line), the item's line."
    (write-new (append (try (catch (read) [{:kind :not-found} (ok "")])) text)))

  (on (done line)
    "Ticks the open item at line; (err {:kind :no-item}) if there isn't one there."
    (let [text (try (read))
          lines (string/lines text)]
      (match (vector/find (parse text) (fn ({:line l :done d}) (and (= l line) (not d))))
        [(none) (err {:kind :no-item :message (str "no open item at line " line)})]
        [(some _)
         (let [ticked (string/replace-first (unwrap (vector/get lines (- line 1))) "[ ]" "[x]")
               new (vector/set lines (- line 1) ticked)]
           (do (try (file/write-atomic file (string/concat (string/join new "\n") "\n")))
               (ok :done)))]))))
