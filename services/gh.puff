; gh: pull requests and their checks for the repository in the caller's
; directory, through the gh CLI. It changes nothing on GitHub. It can also
; watch repositories: every 5 minutes it looks at their open pull requests
; and publishes :gh/changed {:dir :prs} for each whose changed.
;   whiff call gh/prs
;   whiff call gh/checks
;   whiff call gh/checks-of 12
;   whiff call gh/watch     ; the repository you're in; gh/unwatch stops
;   whiff sub gh/changed
;
; Its state is each watched directory's open pull requests, as prs gives
; them, as it last saw them.

(service gh :state {}
  :start (fn (state) (do (send-after every :tick) (ok state)))

  (def every 5m) ; how often it looks at the watched repositories

  ; gh-in runs gh with args in dir and reads what it prints as JSON: (ok
  ; v), or (err {:kind :gh}) with what it said. A failing exit in ok-exits
  ; that still prints JSON is ok: gh pr checks exits 1 when a check failed
  ; and 8 while one is pending, but 1 too when there is no pull request.
  (def (gh-in dir args ok-exits)
    (match (try (proc/run (vector/concat ["gh"] args) {:dir dir}))
      [{:exit 0 :stdout out} (json/parse out)]
      [{:exit n :stdout out} when (and (vector/contains? ok-exits n) (string/starts-with? out "[")) (json/parse out)]
      [{:exit n :stderr e} (err {:kind :gh :exit n :message (string/trim e)})]))

  ; gh is gh-in the caller's directory.
  (def (gh args ok-exits) (gh-in (os/cwd) args ok-exits))

  (def (at s) (unwrap (time/from-string s)))

  (def (review s)
    (match s
      ["APPROVED" :approved] ["CHANGES_REQUESTED" :changes-requested]
      ["REVIEW_REQUIRED" :review-required] [_ :none]))

  (def (pull p)
    (match p
      [{:number n :title title :author {:login who} :headRefName branch :isDraft draft
        :reviewDecision r :url url :createdAt created}
       {:number n :title title :author who :branch branch :draft draft :review (review r)
        :url url :created (at created)}]))

  (def (bucket s)
    (match s
      ["pass" :pass] ["fail" :fail] ["pending" :pending] ["skipping" :skipping]
      ["cancel" :cancel] [_ :unknown]))

  (def (check c)
    (match c
      [{:name name :workflow w :bucket b :link link}
       {:name name :workflow w :bucket (bucket b) :link link}]))

  ; checks-for is the checks of the pull request args name, the current
  ; branch's if none; a pull request without checks has none.
  (def (checks-for args)
    (match (gh (vector/concat ["pr" "checks"] args ["--json" "name,workflow,bucket,link"]) [1 8])
      [(ok cs) (ok (vector/map cs check))]
      [(err {:message m}) when (string/starts-with? m "no checks reported") (ok [])]
      [e e]))

  ; open-prs is dir's open pull requests, as prs gives them.
  (def (open-prs dir)
    (let [ps (try (gh-in dir ["pr" "list" "--json" "number,title,author,headRefName,isDraft,reviewDecision,url,createdAt"] []))]
      (ok (vector/map ps pull))))

  ; look looks at each watched directory and publishes :gh/changed for
  ; those whose pull requests changed: [changed state], with changed their
  ; directories. A directory gh fails in keeps what it had.
  (def (look state)
    (vector/reduce (map/entries state) [[] state]
      (fn (acc e)
        (let [[changed s] acc
              [dir old] e]
          (match (open-prs dir)
            [(ok ps) when (not (= ps old))
             (do (publish :gh/changed {:dir dir :prs ps})
                 [(vector/append changed dir) (map/set s dir ps)])]
            [_ acc])))))

  (on (prs state) :read
    "The open pull requests, newest first: each {:number :title :author :branch :draft :review :url :created}, with :review one of :approved, :changes-requested, :review-required or :none."
    (open-prs (os/cwd)))

  (on (checks state) :read
    "The checks of the current branch's pull request: each {:name :workflow :bucket :link}, with :bucket one of :pass, :fail, :pending, :skipping or :cancel."
    (checks-for []))

  (on (checks-of state pr) :read
    "The checks of pull request pr, a number, as checks gives them."
    (match pr
      [n when (= (value/type n) :int) (checks-for [(int/to-string n)])]
      [_ (err {:kind :bad-call :message (string/concat "want a pull request's number, got " (value/to-string pr))})]))

  (on (watch state) :write :update
    "Watches the repository in the caller's directory: every 5 minutes, :gh/changed {:dir :prs} if its open pull requests changed. (ok :watching), or (err {:kind :gh}) if gh can't list them there."
    (let [dir (os/cwd)
          ps (try (open-prs dir))]
      (ok [:watching (map/set state dir (map/get-or state dir ps))])))

  (on (unwatch state) :write :update
    "Stops watching the repository in the caller's directory."
    (ok [:done (map/delete state (os/cwd))]))

  (on (watching state) :read
    "The directories watched."
    (ok (map/keys state)))

  (on (poll state) :read :update
    "Looks at the watched repositories now, as it does every 5 minutes: (ok dirs), the directories whose pull requests changed."
    (ok (look state)))

  (on (tick state) :read :update
    "Polls, and ticks again in 5 minutes; whiff's own loop: call poll instead."
    (do (send-after every :tick)
        (ok (look state)))))
