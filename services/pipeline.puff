; pipeline: a small dev pipeline of two Claudes. A dev Claude makes a
; change in a git worktree of its own, whiff runs your check there, and a
; reviewer Claude, with no tools, reviews the diff. Until the reviewer
; approves and the check passes, the review goes back to the dev, in the
; same session, for up to 3 rounds. Then the work is committed on the
; run's branch and how it went lands in your inbox. Your working tree is
; never touched until you merge the branch, yourself or with merge, which
; only fast-forwards. Needs git and the claude CLI.
;   whiff call pipeline/start "add a --verbose flag" '["go" "test" "./..."]'
;   whiff call pipeline/runs        ; each run and where it is
;   whiff call pipeline/view        ; the same as items, to show or cancel
;   whiff call pipeline/show 1      ; its last review and the diff it was of
;   whiff call pipeline/cancel 1
;   whiff call pipeline/retry 2 "keep the old flag too"   ; after it gave up
;   whiff call pipeline/review-again 3   ; after its reviewer failed
;   whiff call pipeline/merge 1     ; once it is ready; its worktree goes
;   whiff call pipeline/discard 2   ; or throw it away, worktree and branch
;   whiff inbox                     ; how a run ended
;   whiff sub pipeline/done
;   whiff sub pipeline/step         ; {:run :step} as a run takes each step
;
; A run's worktree is ~/.whiff/pipelines/<repo>-<n>, on branch whiff/<n>.
; Its state is the runs and the jobs they wait for; a run whose job was
; running when whiff stopped fails, as jobs aren't resumed, and offers
; retry or discard. If whiff died, the job may still be running, and retry
; refuses until it isn't. If whiff dies as a run starts, before its state is
; stored, the run's worktree and branch stay, and the next run skips them.

(service pipeline :state {:next 1 :runs {} :jobs {}}
  (def rounds 3)
  (def home (path/join (os/home) ".whiff" "pipelines"))

  (def dev-system """
    You are the developer in a small pipeline. Make the change you are asked
    for in this repository, keeping to its style, and add or update tests.
    You can read and edit files, run the check command with any arguments
    (as go test -race), and go vet, go build, gofmt and git status, diff
    and log; your permissions refuse other commands. Don't commit: the pipeline
    commits your work once its reviewer approves. End with a short summary
    of what you changed.
    """)

  ; from-of is who sent build id, still in the inbox: its address, or :you
  ; for a client's, which has none.
  (def (from-of id)
    (match (vector/find (inbox :build) (fn ({:id i}) (= i id)))
      [(some m) (map/get-or m :from :you)]
      [(none) :you]))

  ; models are a build's run fields for its model: a string, the dev's,
  ; or {:dev :reviewer}, each's; "" for the default.
  (def (models model)
    (if (= (value/type model) :map)
      (let [m {:model (map/get-or model :dev "") :reviewer-model (map/get-or model :reviewer "")}]
        (match (map/get model :sandbox)
          [(some s) (map/set m :sandbox s)]
          [(none) m]))
      {:model model}))

  (test "a build names the dev's model, or the dev's and reviewer's, and whether it is sandboxed"
    (= [(models "haiku") (models {:reviewer "sonnet"}) (models {:dev "openrouter/x/y" :sandbox #t})]
      [{:model "haiku"} {:model "" :reviewer-model "sonnet"} {:model "openrouter/x/y" :reviewer-model "" :sandbox #t}]))

  ; sandboxable says whether a run with extra's fields can be sandboxed as
  ; it asks: its dev's commands run in huff's Bash, which a sandbox wraps,
  ; so a sandboxed run needs a dev on huff.
  (def (sandboxable extra)
    (match (map/get-or extra :sandbox #f)
      [#f (ok :done)]
      [s when (not (vector/contains? [#t {:net #t} {:net #f}] s))
       (err {:kind :bad-sandbox :message (str ":sandbox wants #t, or {:net #t} for one with the network, got " (value/to-string s))})]
      [_ when (not (huff? (map/get-or extra :model "")))
       (err {:kind :no-sandbox :message "a sandboxed run needs its dev on huff, a provider's model as openrouter/moonshotai/kimi-k2"})]
      [_ (ok :done)]))

  (test "a sandboxed run needs its dev on huff"
    (= (vector/map [{} {:model "haiku" :sandbox #t} {:model "openrouter/x/y" :sandbox {:net #t}} {:model "openrouter/x/y" :sandbox "yes"}]
         (fn (e) (match (sandboxable e) [(ok _) :ok] [(err {:kind k}) k])))
      [:ok :no-sandbox :ok :bad-sandbox]))

  ; sandbox-flags are huff's flags for run's :sandbox.
  (def (sandbox-flags run)
    (match (map/get-or run :sandbox #f)
      [#f []]
      [{:net #t} ["-sandbox" "-net"]]
      [_ ["-sandbox"]]))

  ; agent-of is the agent whose build id is, still in the inbox: its
  ; sender, or the session it is the work of, as when :board/build asks
  ; for a lead; else from-of's.
  (def (agent-of id)
    (match (vector/find (inbox :build) (fn ({:id i}) (= i id)))
      [(some m)
       (let [from (map/get-or m :from :you)]
         (match (map/get m :session)
           [(some s) when (not (string/starts-with? (value/to-string from) ":agent/")) s]
           [_ from]))]
      [(none) :you]))

  ; asks? is whether service name has an ask function, as an agent does.
  (def (asks? name)
    (match (keyword/from-string name)
      [(ok k) (match (address/describe k)
                [(ok fns) (vector/any? fns (fn (f) (= (map/get f :fn) (some :ask))))]
                [_ #f])]
      [_ #f]))

  ; ask-text is what a dev whose run an agent started is told of asking it.
  (def (ask-text lead n)
    (str "You are run " n " of a pipeline :" lead " started, one of several working on parts of the same project. "
      "If you need a decision the task and the repository don't settle, as a name or an interface another part depends on, "
      "ask :" lead " with the " lead "_ask tool, saying which run you are, and wait for its answer with the wait tool, "
      "for up to 600 seconds at a time. Otherwise decide yourself and go on.\n\n"))

  (def review-prompt """
    You are the reviewer in a small pipeline. Below are the task, the result
    of the project's check, the files the task names as they are with the
    change, and the diff the developer made. You have no tools: judge from
    these alone, and take the check's result as given. Where the task
    points to a file as the spec, as a README, hold the work to it.
    The work is uncommitted on purpose: the pipeline commits it once you
    approve, so don't count that, or a task's asking for it, against it.
    List the real problems (bugs, missing tests, the task not done), most
    important first, each with its file and line and why. Skip style nits.
    End with two lines on their own. The first is the commit's subject:
    what the change does, in the imperative, under 72 characters, as

    SUBJECT: Add a test that two files are counted together

    and the last is

    VERDICT: approve, if it is ready to commit, or
    VERDICT: changes, if it needs another round.
    """)

  (def (git dir args) (proc/output (vector/concat ["git" "-C" dir] args)))

  ; in runs git in run's worktree as its own gitdir, never as the .git
  ; there says: the dev can write that file, and a gitdir it planted
  ; would have git run what its config says (core.fsmonitor, say) here,
  ; on the host, out of any sandbox. whiff keeps the gitdir from when it
  ; made the worktree, before any dev ran; a run from before it did has
  ; its worktree's, by name, in the repository's .git.
  (def (in run args)
    (let [{:dir dir :repo repo} run
          gitdir (match (map/get-or run :gitdir "")
                   ["" (path/join (string/trim (try (git repo ["rev-parse" "--path-format=absolute" "--git-common-dir"])))
                         "worktrees" (path/base dir))]
                   [g g])]
      (git dir (vector/concat [(str "--git-dir=" gitdir) (str "--work-tree=" dir)] args))))

  ; heard is a publish's result, r, as one a run goes on after: a refused
  ; publish (nobody reviews, say) mustn't leave a run where it was.
  (def (heard r) (or-else r :unheard))

  (def (run-of state n) (unwrap (map/get-in state [:runs n])))

  ; set-run sets run n's fields to those of m.
  (def (set-run state n m)
    (map/update-in state [:runs n] (fn (run) (map/merge run m))))

  ; waiting notes that run n waits for job id at step, and says so on
  ; :pipeline/step.
  (def (waiting state n step id)
    (do (heard (publish :pipeline/step {:run n :step step}))
      (-> state
        (map/set-in [:jobs id] [n step])
        (set-run n {:step step :job id}))))

  ; check-prefix is what of the check the dev may run with any arguments:
  ; its program and first argument, so go test with -race or -run too. A
  ; check runs the repository's own code, which the dev writes, so this
  ; gives it nothing it hadn't.
  (def (check-prefix check) (string/join (vector/slice check 0 (min 2 (vector/length check))) " "))

  (test "the dev may run the check's program and first argument with any arguments"
    (= [(check-prefix ["go" "test" "./..."]) (check-prefix ["make"])] ["go test" "make"]))

  ; dev-cmd is the dev's claude, on the run's :model if it has one: its
  ; session's first turn, or a later one once a turn has ended in it,
  ; :resumable. It may run the check, as it is
  ; or with more arguments, and no MCP servers: none of your own Claude
  ; setup's.
  ; A run an agent started has whiff mcp too, reaching only the agent's ask.
  (def (dev-cmd run)
    (match run
      [_ when (huff? (map/get-or run :model "")) (huff-dev-cmd run)]
      [{:session s :check check}
       (vector/concat
         ["claude" "-p"]
         (match (map/get-or run :lead "")
           ["" []]
           [_ ["--mcp-config" (json/to-string {:mcpServers {:whiff {:command "whiff" :args ["mcp"]}}})]])
         ["--strict-mcp-config" "--tools" "Read,Edit,Write,Glob,Grep,Bash"
          "--allowedTools" (str "Bash(" (string/join check " ") ")") (str "Bash(" (check-prefix check) ":*)")
          "Bash(go vet:*)" "Bash(go build:*)" "Bash(gofmt:*)" "Bash(git status:*)" "Bash(git diff:*)" "Bash(git log:*)"]
         (match (map/get-or run :lead "") ["" []] [_ ["mcp__whiff"]])
         ["--permission-mode" "acceptEdits" "--verbose" "--output-format" "stream-json" "--append-system-prompt" dev-system]
         (match (map/get-or run :model "") ["" []] [m ["--model" m]])
         (if (map/get-or run :resumable #f) ["--resume" s] ["--session-id" s]))]))

  ; huff? says whether model names a provider, as openrouter/moonshotai/
  ; kimi-k2: huff runs it, not claude.
  (def (huff? model) (string/contains? model "/"))

  ; transcript is where huff keeps session s's conversation, so a retry
  ; goes on from it, as claude's --resume does.
  (def (transcript s) (path/join (os/home) ".whiff" "huff" (str s ".puff")))

  ; huff-dev-cmd is the dev's huff, with the same tools and commands as
  ; its claude: whiff's lead/ask comes with its job's session.
  (def (huff-dev-cmd run)
    (match run
      [{:session s :check check :model model}
       (vector/concat
         ["huff" "-json" "-m" model "-s" dev-system "-t" (transcript s) "-calls" "60"
          "-tools" "Read,Edit,Write,Glob,Grep,Bash"]
         (sandbox-flags run)
         (vector/reduce [(string/join check " ") (str (check-prefix check) ":*") "go vet:*" "go build:*" "gofmt:*"
                         "git status:*" "git diff:*" "git log:*"]
           [] (fn (args c) (vector/concat args ["-allow" c]))))]))

  (test "a dev on a provider's model runs on huff, with the tools and commands claude's has"
    (= (vector/slice (dev-cmd {:session "s1" :check ["go" "test" "./..."] :model "openrouter/x/y"}) 0 4)
      ["huff" "-json" "-m" "openrouter/x/y"]))

  (test "a sandboxed run's huff dev runs its commands sandboxed"
    (let [run {:session "s1" :check ["go" "test" "./..."] :model "openrouter/x/y"}
          has? (fn (r flag) (vector/contains? (dev-cmd r) flag))]
      (= [(has? run "-sandbox") (has? (map/set run :sandbox #t) "-sandbox") (has? (map/set run :sandbox #t) "-net")
          (has? (map/set run :sandbox {:net #t}) "-net")]
        [#f #t #f #t])))

  (def (dev state n input)
    (let [run (run-of state n)
          opts {:stdin input :dir (map/get-or run :dir "") :as :text :timeout 30m :stream #t :output :file}
          lead (map/get-or run :lead "")
          id (try (submitted (call :jobs/run (dev-cmd run)
                               (if (= lead "") opts (map/set opts :session [(unwrap (keyword/from-string (str lead "/ask")))])))))]
      (ok (waiting state n :dev id))))

  (def (check state n)
    (let [run (run-of state n)
          {:check cmd :dir dir} run
          opts {:dir dir :timeout 10m :output :file}
          opts (match (map/get-or run :sandbox #f) [#f opts] [s (map/set opts :sandbox s)])
          id (try (submitted (call :jobs/run cmd opts)))]
      (ok (waiting state n :check id))))

  (def (passed? checked) (match checked [{:exit 0} #t] [_ #f]))

  ; tail is the last 4000 characters of s.
  (def (tail s) (string/slice s (max 0 (- (string/length s) 4000))))

  (def (check-text checked)
    (match checked
      [{:exit 0} "passed"]
      [{:exit n :stdout out :stderr e} (str "failed with exit " n ":\n" (tail (str out e)))]))

  ; head is s cut to its first k characters, saying so.
  (def (head s k) (if (> (string/length s) k) (str (string/slice s 0 k) "\n[cut at " k " characters]") s))

  ; named are the files in the repository at dir that task names by
  ; path, as README.md, with what they hold with the change: [[path
  ; text]], the first 5, each cut to 20000 characters.
  (def (named run task)
    (let [hits (vector/filter (string/lines (or-else (in run ["ls-files"]) ""))
                 (fn (p) (and (not (= p "")) (string/contains? task p))))]
      (vector/map (vector/slice hits 0 (min 5 (vector/length hits)))
        (fn (p) [p (head (or-else (in run ["show" (str ":" p)]) "") 20000)]))))

  ; files-text is named's files for the reviewer.
  (def (files-text files)
    (if (vector/empty? files)
      ""
      (str "\n\nThe files the task names, with the change:"
        (string/join (vector/map files (fn ([p text]) (str "\n\n--- " p "\n" text))) ""))))

  (test "the reviewer gets the files the task names, each cut to its limit"
    (= [(files-text []) (files-text [["README.md" "# x"]]) (head "abcdef" 3)]
      ["" "\n\nThe files the task names, with the change:\n\n--- README.md\n# x" "abc\n[cut at 3 characters]"]))

  ; reviewer-cmd is the reviewer, without tools, on model: claude's JSON
  ; result, or huff's stream, whose last line is the same.
  (def (reviewer-cmd model)
    (cond
      [(huff? model) ["huff" "-json" "-m" model "-calls" "2"]]
      [(= model "") ["claude" "-p" "--strict-mcp-config" "--tools" "" "--no-session-persistence" "--output-format" "json"]]
      [_ ["claude" "-p" "--strict-mcp-config" "--tools" "" "--no-session-persistence" "--output-format" "json" "--model" model]]))

  (def (review state n checked)
    (let [run (run-of state n)
          {:dir dir :base base :task task} run
          model (map/get-or run :reviewer-model "")
          _ (try (in run ["add" "-A"]))
          diff (try (in run ["diff" "--cached" base]))]
      (if (= diff "")
        (finish state n :failed "The developer changed nothing.")
        (let [input (str review-prompt "\n\nTask: " task "\n\nThe check " (check-text checked) (files-text (named run task)) "\n\nThe diff:\n" diff)
              id (try (submitted (call :jobs/run (reviewer-cmd model)
                                   {:stdin input :dir dir :as :text :timeout 10m :stream (huff? model) :output :file})))]
          (ok (waiting (set-run state n {:checked checked :diff diff}) n :review id))))))

  ; subject is a commit's subject, at most 72 characters: the review's
  ; SUBJECT: line, what the reviewer says the change does, having seen
  ; the diff; else task's first sentence. The whole task goes in the
  ; commit's body.
  (def (subject task review)
    (let [said (vector/find (vector/map (string/lines review) string/trim)
                 (fn (l) (and (string/starts-with? l "SUBJECT:") (> (string/length l) 8))))
          first (match said
                  [(some l) (string/trim (string/slice l 8))]
                  [(none) (string/trim-suffix (match (string/split (string/trim task) ". ") [[f & _] f]) ".")])]
      (if (> (string/length first) 72) (str (string/slice first 0 71) "…") first)))

  (test "a commit's subject is the review's SUBJECT, or the task's first sentence"
    (= [(subject "Read the README. Add a flag." "Fine.\nSUBJECT: Add the -top flag\nVERDICT: approve")
        (subject "  Add a flag. Then test it." "VERDICT: approve") (subject "Add a flag." "SUBJECT:")]
      ["Add the -top flag" "Add a flag" "Add a flag"]))

  (test "a long subject is cut to 72 characters"
    (let [long (string/join (vector/map (vector/range 0 30) (fn (i) "word")) " ")]
      (= (string/length (subject long "")) 72)))

  (test "a check's output is cut to its last 4000 characters"
    (= [(string/length (tail (string/join (vector/map (vector/range 0 5000) (fn (i) "x")) ""))) (tail "abc")] [4000 "abc"]))

  ; commit commits run's work, from its base, as its task. whiff dying
  ; between the commit and the run's state being stored has it run again:
  ; the review saw a diff, so a clean tree past base has it already, and it
  ; isn't committed twice.
  (def (commit run review)
    (let [{:base base :task task} run
          clean (= (try (in run ["status" "--porcelain"])) "")
          head (try (in run ["rev-parse" "HEAD"]))
          from (try (in run ["rev-parse" base]))]
      (if (and clean (not (= head from)))
        (ok :committed)
        (in run ["commit" "-q" "-m" (subject task review) "-m" task]))))

  (def (reviewed state n text)
    (let [{:round round :checked checked :dir dir :task task :branch branch :base base} (run-of state n)
          ; A retried run has rounds more than it had.
          limit (map/get-or (run-of state n) :limit rounds)
          state (set-run state n {:review text})
          approved (string/contains? text "VERDICT: approve")]
      (cond
        [(and (passed? checked) approved)
         (do (try (commit (run-of state n) text))
           (finish state n :ready (str "Committed on " branch " in " dir ", after " round " rounds. The last review:\n\n" text)))]
        [(>= round limit)
         (finish state n :gave-up (str "Not approved after " round " rounds; the work is in " dir ". The last review:\n\n" text))]
        [_
         (dev (set-run state n {:round (+ round 1)}) n
           (str (if approved "" (str "The reviewer asked for changes:\n\n" text "\n\n"))
             (if (passed? checked) "" (str "The check " (check-text checked) "\n\n"))
             "Fix what needs fixing."))])))

  ; ended? is whether a run at step ended without being ready.
  (def (ended? step) (vector/contains? [:gave-up :failed :cancelled] step))

  ; actions are what can be done about run n, on branch, once it ended as
  ; status at step from: show its last review and diff; merge it if it is
  ; ready, or retry or discard it if it ended otherwise. One whose reviewer
  ; failed can be reviewed again first: Retry would rerun the dev.
  (def (actions n status branch from)
    (let [show {:label "Show review and diff" :action [:pipeline/show n]}
          again (if (and (= status :failed) (= from :review)) [{:label "Review again" :action [:pipeline/review-again n]}] [])]
      (cond
        [(= status :ready) [show {:label (str "Merge " branch) :action [:pipeline/merge n]}]]
        [(ended? status)
         (vector/concat [show] again
           [{:label "Retry with a note" :action [:pipeline/retry n] :ask "A note for the developer, if any"}
            {:label "Discard" :action [:pipeline/discard n]}])]
        [_ [show]])))

  (test "a ready run can be merged, one that didn't end ready retried or discarded"
    (= [(actions 1 :ready "whiff/1" :review) (actions 2 :gave-up "whiff/2" :review) (actions 3 :merged "whiff/3" :none)]
      [[{:label "Show review and diff" :action [:pipeline/show 1]}
        {:label "Merge whiff/1" :action [:pipeline/merge 1]}]
       [{:label "Show review and diff" :action [:pipeline/show 2]}
        {:label "Retry with a note" :action [:pipeline/retry 2] :ask "A note for the developer, if any"}
        {:label "Discard" :action [:pipeline/discard 2]}]
       [{:label "Show review and diff" :action [:pipeline/show 3]}]]))

  (test "a run whose reviewer failed can be reviewed again; one whose dev failed can't"
    (= [(vector/map (actions 4 :failed "whiff/4" :review) (fn ({:label l}) l))
        (vector/map (actions 5 :failed "whiff/5" :dev) (fn ({:label l}) l))]
      [["Show review and diff" "Review again" "Retry with a note" "Discard"]
       ["Show review and diff" "Retry with a note" "Discard"]]))

  ; tidy removes run n's worktree and branch, as what was in them is
  ; merged or not wanted, and marks it step, :merged or :discarded.
  (def (tidy state n step)
    (let [{:repo repo :dir dir :branch b} (run-of state n)]
      (do (or-else (git repo ["worktree" "remove" "--force" dir]) "")
        (or-else (git repo ["branch" "-D" b]) "")
        (heard (publish :pipeline/step {:run n :step step}))
        (set-run state n {:step step}))))

  ; finish ends run n as status, telling you in your inbox unless it is
  ; quiet, with what you can do about it, and on :pipeline/done. :from is
  ; the step it ended at.
  (def (finish state n status note)
    (let [{:task task :branch branch :dir dir :quiet quiet} (run-of state n)
          from (map/get-or (run-of state n) :step :none)
          note (str note (refused-text (map/get-or (run-of state n) :denied [])))]
      ; :me/tell answers pending, as it waits in your inbox.
      (do (if quiet :quiet (or-else (call :me/tell (str "pipeline " n ", " task ": " (keyword/name status) ". " note) {:actions (actions n status branch from)}) :told))
        ; A build's asker hears how it ended, with what can be done about
        ; it, which :tasks shows you; an agent asker may take one only if
        ; its :can reaches it, as lead's doesn't.
        (match (map/get (run-of state n) :asker)
          [(some a) (or-else (reply a (ok {:run n :status status :branch branch :dir dir :note note
                                           :cost (map/get-or (run-of state n) :cost 0.0)
                                           :actions (actions n status branch from)})) :gone)]
          [(none) :none])
        (heard (publish :pipeline/done {:run n :status status :branch branch :dir dir :note note :from from}))
        ; After :pipeline/done, so a planner hears of the end first.
        (heard (publish :pipeline/step {:run n :step status}))
        (ok (set-run state n {:step status :from from})))))

  ; denied are the tool calls the dev's Claude's own permissions refused,
  ; from out, its JSON result: "Bash go test -race ./...", or the tool's
  ; name. None if out isn't its JSON.
  (def (denied out)
    (match (json/parse out)
      [(ok res) when (= (value/type res) :map)
       (vector/map (map/get-or res :permission_denials [])
         (fn (d) (match (map/get-in d [:tool_input :command])
                   [(some c) (str (map/get-or d :tool_name "a tool") " " c)]
                   [(none) (map/get-or d :tool_name "a tool")])))]
      [_ []]))

  ; review-text is the reviewer's review, from out, its JSON result; out
  ; itself if it isn't that.
  (def (review-text out)
    (match (json/parse out)
      [(ok res) when (= (value/type res) :map) (map/get-or res :result out)]
      [_ out]))

  (test "a review, from the reviewer's JSON, or as it is"
    (= [(review-text "{\"result\":\"VERDICT: approve\",\"total_cost_usd\":0.02}") (review-text "VERDICT: approve")]
      ["VERDICT: approve" "VERDICT: approve"]))

  ; dev-cost is what a dev or reviewer turn cost, from out, its JSON
  ; result: 0.0 if out isn't that.
  (def (dev-cost out)
    (match (json/parse out)
      [(ok res) when (= (value/type res) :map)
       (match (map/get-or res :total_cost_usd 0.0) [c when (= (value/type c) :float) c] [c (float/from-int c)])]
      [_ 0.0]))

  (test "a dev turn's cost, from its JSON"
    (= [(dev-cost "{\"total_cost_usd\":0.25}") (dev-cost "{\"total_cost_usd\":0}") (dev-cost "a summary")] [0.25 0.0 0.0]))

  ; refused-text is what a run's note says of what its permissions refused its dev:
  ; nothing if it refused nothing. whiff refused none of it.
  (def (refused-text calls)
    (if (vector/empty? calls) ""
      (str "\n\nThe developer's permissions refused it these, those pipeline gives it (whiff's review wasn't asked): "
        (string/join (vector/map calls (fn (c) (str "`" c "`"))) ", ") ".")))

  (test "a dev's refused calls, from its JSON, and what the note says of them"
    (= [(denied "{\"permission_denials\":[{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"go test -race ./...\"}},{\"tool_name\":\"WebFetch\",\"tool_input\":{}}]}")
        (denied "a summary") (refused-text [])]
      [["Bash go test -race ./..." "WebFetch"] [] ""]))

  ; why is e, an err, for people: its message, with the end of what it
  ; printed, as a command that failed says why there; or e as puff.
  (def (why e)
    (match e
      [{:message m}
       (let [out (string/trim (str (map/get-or e :stderr "") "\n" (map/get-or e :stdout "")))]
         (if (= out "") m (str m ":\n\n" (string/slice out (max 0 (- (string/length out) 600))))))]
      [_ (value/to-string e)]))

  (test "why a step failed: its message and what it printed, or the err"
    (= [(why {:kind :exit :message "git exited 1" :stderr "" :stdout "nothing to commit\n"}) (why {:kind :start})]
      ["git exited 1:\n\nnothing to commit" "{:kind :start}"]))

  ; failure is a run's note when a step, what saying which, failed with e in
  ; round, as task id, whose record whiff wait has: why, and, if the step
  ; may still be running after whiff died, how to stop it.
  (def (failure what round id e)
    (str what " in round " round " (task " id ", whiff wait " id "): " (why e)
      (match e
        [{:pid pid} (str "\n\nIt may still be running, as process group " pid ", and Retry refuses until it isn't. To stop it: kill -- -" pid)]
        [_ ""])))

  (test "a failure says where, and if it may still be running, how to stop it"
    (= [(failure "The check didn't run" 1 7 {:kind :start}) (string/contains? (failure "The developer failed" 2 8 {:kind :interrupted :pid 42}) "kill -- -42")]
      ["The check didn't run in round 1 (task 7, whiff wait 7): {:kind :start}" #t]))

  ; step-done takes run n on from the result r of the job it waited for at
  ; step; a run cancelled meanwhile stays as it is.
  (def (step-done state n step id r)
    (let [run (run-of state n)
          round (map/get-or run :round 1)]
      (cond
        [(not (= (map/get-or run :step :none) step)) (ok state)]
        [(= step :dev)
         (match r
           [(ok out) (check (set-run state n {:resumable #t
                                              :denied (vector/concat (map/get-or run :denied []) (denied out))
                                              :cost (+ (map/get-or run :cost 0.0) (dev-cost out))}) n)]
           [(err e) (finish state n :failed (failure "The developer failed" round id e))])]
        [(= step :check)
         (match r
           [(ok checked) (review state n checked)]
           [(err e) (finish state n :failed (failure "The check didn't run" round id e))])]
        [_
         (match r
           [(ok out) (reviewed (set-run state n {:cost (+ (map/get-or run :cost 0.0) (dev-cost out))}) n (review-text out))]
           [(err e) (finish state n :failed (failure "The reviewer failed" round id e))])])))

  ; stray is (ok (some pid)) if run's last job may still be running, in
  ; process group pid: whiff died while it ran, or it's being cancelled.
  (def (stray run)
    (match (map/get run :job)
      [(some id) (call :jobs/process id)]
      [(none) (ok (none))]))

  (def (active? step) (vector/contains? [:dev :check :review] step))

  ; retry-input is what the dev gets when you retry run: your note, if
  ; any, and the last review, in the session it has; or the task, with
  ; your note, in a new one.
  (def (retry-input run note)
    (let [noted (if (= note "") "" (str "A note from the user:\n\n" note "\n\n"))]
      (if (map/get-or run :resumable #f)
        (str noted
          (match (map/get run :review) [(some r) (str "The last review:\n\n" r "\n\n")] [(none) ""])
          "Fix what needs fixing.")
        (str "Task: " (map/get-or run :task "") "\n\n" noted))))

  (test "a retry resumes with your note and the last review, or starts again with the task"
    (= [(retry-input {:resumable #t :review "no tests"} "add them") (retry-input {:task "t"} "")]
      ["A note from the user:\n\nadd them\n\nThe last review:\n\nno tests\n\nFix what needs fixing." "Task: t\n\n"]))

  ; free is the first run number from n whose worktree and branch in repo
  ; aren't there: whiff dying as a run started leaves them without the run,
  ; as it had no state yet. They stay for you to look at.
  (def (free repo n)
    (loop [n n]
      (if (or (file/exists? (path/join home (str (path/base repo) "-" n)))
            (match (git repo ["rev-parse" "--verify" "-q" (str "refs/heads/whiff/" n)]) [(ok _) #t] [_ #f]))
        (recur (+ n 1))
        n)))

  ; command? is (ok :done) if check is a command, a vector of strings,
  ; as ["go" "test" "./..."]; else why not, before a run takes a worktree.
  (def (command? check)
    (if (and (= (value/type check) :vector) (not (vector/empty? check))
          (vector/all? check (fn (a) (string? a))))
      (ok :done)
      (err {:kind :bad-check :message (str "check wants a command, a vector of strings as [\"go\" \"test\" \"./...\"], got " (value/to-string check))})))

  (test "a check is a command, not text that looks like one"
    (= [(command? ["go" "test" "./..."]) (vector/map ["[\"go\",\"test\"]" [] ["go" 1]] (fn (c) (match (command? c) [(err {:kind k}) k] [_ :ok])))]
      [(ok :done) [:bad-check :bad-check :bad-check]]))

  ; worktree adds a run's worktree and branch in repo, from base, as the
  ; first free run from n: (ok n), or why not. A git worktree add that a
  ; killed whiff began can finish after free looked, taking that n, so a
  ; failed add tries the next free one, 3 times in all.
  (def (worktree repo n base)
    (loop [n (free repo n) tries 1]
      (match (git repo ["worktree" "add" "-q" "-b" (str "whiff/" n) (path/join home (str (path/base repo) "-" n)) base])
        [(ok _) (ok n)]
        [(err _) when (< tries 3) (recur (free repo (+ n 1)) (+ tries 1))]
        [e e])))

  ; begin starts a run on task in repo, from base, a commit or branch, or
  ; a vector of them merged, the first's worktree with the rest merged in:
  ; [n state], or the err it couldn't start for. extra are the run's
  ; fields beyond those, as :model and :asker.
  (def (begin state repo base task check quiet extra)
    (let [_ (try (command? check))
          _ (try (sandboxable extra))
          bases (if (= (value/type base) :vector) base [base])
          base (string/trim (try (git repo ["rev-parse" (unwrap (vector/first bases))])))
          _ (try (file/mkdir home))
          n (try (worktree repo (map/get-or state :next 1) base))
          dir (path/join home (str (path/base repo) "-" n))
          ; Its gitdir, as in uses, from before any dev wrote there; ""
          ; has in find it by name, rather than leave the worktree behind.
          gitdir (string/trim (or-else (git dir ["rev-parse" "--absolute-git-dir"]) ""))
          branch (str "whiff/" n)
          session (uuid/new)
          rest (vector/slice bases 1 (vector/length bases))
          merged (if (vector/empty? rest) (ok "")
                   (git dir (vector/concat ["-c" "user.name=whiff" "-c" "user.email=whiff@localhost" "merge" "-q" "--no-edit" "-m" (str "Merge " (string/join rest ", "))] rest)))
          ; Its base is where the dev starts: the merge, if there is one.
          base (match merged [(ok _) (string/trim (or-else (git dir ["rev-parse" "HEAD"]) base))] [_ base])
          run (map/merge {:task task :repo repo :dir dir :gitdir gitdir :branch branch :base base :check check :round 1 :session session :step :starting :quiet quiet :started (time/now)} extra)
          state (-> state (map/set :next (+ n 1)) (map/set-in [:runs n] run))]
      ; A run that can't start leaves no worktree or branch behind.
      (match (match merged [(ok _) (dev state n (str (match (map/get-or extra :lead "") ["" ""] [l (ask-text l n)]) "Task: " task))] [e e])
        [(ok s) (ok [n s])]
        [(err e)
         (do (or-else (git repo ["worktree" "remove" "--force" dir]) "")
           (or-else (git repo ["branch" "-D" branch]) "")
           (err e))])))

  (on (start state task check) :write :update
    "Starts a run on task in the repository here: a dev Claude makes the change in a worktree of its own, check (a command, like [\"go\" \"test\" \"./...\"]) runs there, and a reviewer Claude reviews the diff, for up to 3 rounds; then it is committed on the run's branch and you hear how it went in your inbox. (ok n), the run's number."
    (begin state (string/trim (try (proc/output ["git" "rev-parse" "--show-toplevel"]))) "HEAD" task check #f {}))

  (on (start-on state repo base task check model) :write :update
    "Starts a run as start does, in the repository at repo, from base, a commit or branch such as an earlier run's, with the dev on model (\"\" for the default) or {:dev :reviewer :sandbox}, as build takes them, without telling you how it ends (:pipeline/done still does): how a planner stacks runs. (ok n)."
    (begin state repo base task check #t (models model)))

  (ask (build repo base task check model)
    "Runs task as start-on does, in the repository at repo, from base (a commit or branch, or a vector of them, merged), with the dev Claude on model (\"\" for the default), or with {:dev :reviewer}, each's model, and :sandbox #t to run the dev's commands and the check in a container that sees only the run's worktree, without the network unless {:net #t}, for a dev on huff: pending at once, and once the run ends (ok {:run :status :branch :dir :note :cost :actions}), :status :ready, :gave-up or :failed, :cost what its dev and reviewer turns cost in dollars, :actions what you can do about it, as Merge or Retry. How an agent hands work to smaller ones and hears back.")

  (on (whiff/asked state id) :update
    "A build waits in the inbox: its run starts now, unless it has. whiff's own; call build instead."
    (cond
      [(vector/any? (map/values (map/get-or state :runs {})) (fn (run) (= (map/get run :asker) (some id)))) (ok state)]
      [_
       (match (vector/find (inbox :build) (fn ({:id i}) (= i id)))
         [(some {:args [repo base task check model]})
          ; An agent's turn asks from :agent/<name>: its devs may ask it.
          (match (begin state repo base task check #t
                   (map/merge (models model) {:asker id}
                     (match (string/split (value/to-string (agent-of id)) "/")
                       [[":agent" name] when (asks? name) {:lead name}]
                       [_ {}])))
            [(ok [_ s]) (ok s)]
            [(err e) (let [_ (reply id (err e))] (ok state))])]
         [_ (ok state)])]))

  (on (whiff/cancelled state id) :update
    "The build id was cancelled while it waited, as by its agent's cancel: the run begun for it is cancelled, as cancel does, and nobody hears how it ends. whiff's own; call cancel instead."
    (match (vector/find (map/entries (map/get-or state :runs {}))
             (fn ([_ run]) (and (= (map/get run :asker) (some id)) (active? (map/get-or run :step :none)))))
      [(some [n {:job j}])
       (do (or-else (call :jobs/cancel j) :gone)
         (publish :pipeline/step {:run n :step :cancelled})
         (ok (set-run state n {:step :cancelled})))]
      [(some [n _])
       (do (publish :pipeline/step {:run n :step :cancelled})
         (ok (set-run state n {:step :cancelled})))]
      [_ (ok state)]))

  (on (runs state) :read
    "Every run, oldest first: {:run :task :step :round :branch :dir :from :cost :started}, with :step one of :dev, :check, :review, :ready, :gave-up, :failed, :cancelled, :merged or :discarded, :from the step an ended run ended at (:none while it runs), :cost what its turns cost so far in dollars, and :started when it started, (none) for one from before whiff kept it."
    (ok (vector/map (map/entries (map/get-or state :runs {}))
          (fn ([n run])
            (let [{:task t :step s :round r :branch b :dir d} run]
              {:run n :task t :step s :round r :branch b :dir d :from (map/get-or run :from :none)
               :cost (map/get-or run :cost 0.0) :started (map/get run :started)})))))

  ; run-actions are what can be done about run n now: show it, and cancel
  ; it while it runs, or what actions offers once it ended, unless a
  ; planner runs it.
  (def (run-actions n run)
    (let [{:step s :branch b} run
          show {:label "Show review and diff" :action [:pipeline/show n]}]
      (cond
        [(active? s) [show {:label "Cancel the run" :action [:pipeline/cancel n]}]]
        [(map/get-or run :quiet #f) [show]]
        [_ (actions n s b (map/get-or run :from :none))])))

  ; no-run is (err {:kind :no-run}) for an action run n doesn't take now,
  ; saying why, with :actions, the ones it does take, if it is there.
  (def (no-run state n why)
    (err {:kind :no-run :message why
          :actions (match (map/get-in state [:runs n])
                     [(some run) (run-actions n run)]
                     [_ []])}))

  (test "an action a run doesn't take offers the ones it does"
    (= (no-run {:runs {2 {:step :ready :branch "whiff/2"}}} 2 "run 2 is ready")
      (err {:kind :no-run :message "run 2 is ready"
            :actions [{:label "Show review and diff" :action [:pipeline/show 2]}
                      {:label "Merge whiff/2" :action [:pipeline/merge 2]}]})))

  (on (view state) :read
    "The runs as a view: each shows its last review and diff, cancels it while it runs, and merges it once ready or retries it once it ended otherwise, unless a planner runs it."
    (ok (view/items (vector/map (map/entries (map/get-or state :runs {}))
                      (fn ([n run])
                        (let [{:task t :step s :round r :branch b} run]
                          {:label (str n "  " t) :detail (str (keyword/name s) ", round " r ", " b)
                           :actions (run-actions n run)})))
          {:changed :pipeline/step})))

  (on (show state n) :read
    "Run n, its last review and the diff that review was of, as a view of text; (err {:kind :no-run}) if there is no such run."
    (match (map/get-in state [:runs n])
      [(some run)
       (let [{:task t :step s :round r :branch b} run]
         (ok (view/text (str "Run " n ": " t "\n" (keyword/name s) ", round " r ", " b
                          "\n\nThe last review:\n\n" (map/get-or run :review "None yet.")
                          "\n\nThe diff it reviewed:\n\n" (map/get-or run :diff "None yet."))
               {:changed :pipeline/step})))]
      [_ (err {:kind :no-run :message (str "no run " n)})]))

  (on (cancel state n) :write :update
    "Cancels run n: kills the job it waits for and leaves its worktree as it is. (err {:kind :no-run}) if there is no such run, or it has ended, with :actions, what it can do instead."
    (match (map/get-in state [:runs n])
      [(some {:step s :job id}) when (active? s)
       (do (or-else (call :jobs/cancel id) :gone)
         (publish :pipeline/step {:run n :step :cancelled})
         (ok [:cancelled (set-run state n {:step :cancelled})]))]
      [_ (no-run state n (str "no run " n " is going"))]))

  (on (retry state n note) :write :update
    "Takes run n on after it gave up, failed or was cancelled, for up to 3 more rounds: the dev Claude, in the run's worktree, gets note, your words for it (\"\" for none), and the last review. (ok :retrying); (err {:kind :no-run}) unless run n ended so; (err {:kind :still-running :pid}) while its last job may still be running, as after whiff died while it ran."
    (match (map/get-in state [:runs n])
      [(some run) when (ended? (map/get-or run :step :none))
       ; Two devs in one worktree would undo each other's work.
       (match (try (stray run))
         [(some pid)
          (err {:kind :still-running :pid pid
                :message (str "run " n "'s last job may still be running, as process group " pid ": stop it (kill -- -" pid ") or let it end, then retry")})]
         [(none)
          (let [round (map/get-or run :round 1)
                ; A session no dev turn ended in may not exist: a new one.
                fresh (if (map/get-or run :resumable #f) {} {:session (uuid/new)})
                state (set-run state n (map/merge fresh {:round (+ round 1) :limit (+ round rounds)}))]
            (ok [:retrying (try (dev state n (retry-input (run-of state n) note)))]))])]
      [_ (no-run state n (str "run " n " hasn't ended without being ready: nothing to retry"))]))

  ; A reviewer has no tools, so one that may still run after whiff died
  ; can't fight a new one: no stray check, unlike retry.
  (on (review-again state n) :write :update
    "Runs run n's reviewer again on its worktree, in the same round, after the reviewer failed, as by a timeout: the dev isn't rerun. (ok :reviewing); (err {:kind :no-run}) unless run n failed at its review."
    (match (map/get-in state [:runs n])
      [(some {:step :failed :from :review :checked checked})
       (ok [:reviewing (try (review state n checked))])]
      [_ (no-run state n (str "run " n " didn't fail at its review: nothing to review again"))]))

  (on (merge state n) :write :update
    "Merges ready run n's branch into the branch checked out in its repository, only as a fast-forward, then removes the run's worktree and branch: (ok branch); git's error if your branch moved on or your changes are in the way, and (err {:kind :no-run}) unless run n is ready."
    (match (map/get-in state [:runs n])
      [(some {:step :ready :repo repo :branch b})
       (let [_ (try (git repo ["merge" "-q" "--ff-only" b]))]
         (ok [b (tidy state n :merged)]))]
      [_ (no-run state n (str "run " n " isn't ready: nothing to merge"))]))

  (on (discard state n) :write :update
    "Discards run n, ended and not merged: removes its worktree, uncommitted work and all, and its branch. (ok :discarded); (err {:kind :no-run}) unless run n ended so."
    (match (map/get-in state [:runs n])
      [(some {:step s}) when (or (= s :ready) (ended? s))
       (ok [:discarded (tidy state n :discarded)])]
      [_ (no-run state n (str "run " n " hasn't ended, or is gone: nothing to discard"))]))

  (on (whiff/done state id r) :update
    "A job a run waited for is done: the run takes its next step."
    (match (map/get-in state [:jobs id])
      [(none) (ok state)]
      [(some [n step])
       (let [state (map/update state :jobs (fn (js) (map/delete js id)))]
         ; What fails after the job, as the commit after an approval, says so.
         (catch (step-done state n step id r)
           [e (ok (or-else (finish state n :failed (str "After the " (keyword/name step) " step's task " id ": " (why e))) state))]))])))
