; pipeline: a small dev pipeline of two Claudes. A dev Claude makes a
; change in a git worktree of its own, whiff runs your check there, and a
; reviewer Claude, with no tools, reviews the diff. Until the reviewer
; approves and the check passes, the review goes back to the dev, in the
; same session, for up to 3 rounds. Then the work is committed on the
; run's branch and how it went lands in your inbox. Your working tree is
; never touched until you merge the branch, yourself or with merge, which
; only fast-forwards. Needs git and the claude CLI.
;   whiff call pipeline/start "add a --verbose flag" '["go" "test" "./..."]'
;   whiff call pipeline/runs        ; each run and where it is
;   whiff call pipeline/view        ; the same as items, to show or cancel
;   whiff call pipeline/show 1      ; its last review and the diff it was of
;   whiff call pipeline/cancel 1
;   whiff call pipeline/retry 2 "keep the old flag too"   ; after it gave up
;   whiff call pipeline/merge 1     ; once it is ready; its worktree goes
;   whiff call pipeline/discard 2   ; or throw it away, worktree and branch
;   whiff inbox                     ; how a run ended
;   whiff sub pipeline/done
;   whiff sub pipeline/step         ; {:run :step} as a run takes each step
;
; A run's worktree is ~/.whiff/pipelines/<repo>-<n>, on branch whiff/<n>.
; Its state is the runs and the jobs they wait for; a run whose job was
; running when whiff stopped fails, as jobs aren't resumed, and offers
; retry or discard. If whiff died, the job may still be running, and retry
; refuses until it isn't. If whiff dies as a run starts, before its state is
; stored, the run's worktree and branch stay, and the next run skips them.

(service pipeline :state {:next 1 :runs {} :jobs {}}
  (def rounds 3)
  (def home (path/join (os/home) ".whiff" "pipelines"))

  (def dev-system """
    You are the developer in a small pipeline. Make the change you are asked
    for in this repository, keeping to its style, and add or update tests.
    You can read and edit files and run the check command. Don't commit. End
    with a short summary of what you changed.
    """)

  (def review-prompt """
    You are the reviewer in a small pipeline. Below are the task, the result
    of the project's check and the diff the developer made. List the real
    problems (bugs, missing tests, the task not done), most important first,
    each with its file and line and why. Skip style nits. End with one line
    on its own:

    VERDICT: approve, if it is ready to commit, or
    VERDICT: changes, if it needs another round.
    """)

  (def (git dir args) (proc/output (vector/concat ["git" "-C" dir] args)))

  (def (run-of state n) (unwrap (map/get-in state [:runs n])))

  ; set-run sets run n's fields to those of m.
  (def (set-run state n m)
    (map/update-in state [:runs n] (fn (run) (map/merge run m))))

  ; waiting notes that run n waits for job id at step, and says so on
  ; :pipeline/step.
  (def (waiting state n step id)
    (do (publish :pipeline/step {:run n :step step})
      (-> state
        (map/set-in [:jobs id] [n step])
        (set-run n {:step step :job id}))))

  ; dev-cmd is the dev's claude: its session's first turn, or a later one
  ; once a turn has ended in it, :resumable. It may run the check, as it is
  ; or with more arguments, and no MCP servers: none of your own Claude
  ; setup's.
  (def (dev-cmd run)
    (match run
      [{:session s :check check}
       (vector/concat
         ["claude" "-p" "--strict-mcp-config" "--tools" "Read,Edit,Write,Glob,Grep,Bash"
          "--allowedTools" (str "Bash(" (string/join check " ") ")") (str "Bash(" (string/join check " ") ":*)")
          "--permission-mode" "acceptEdits" "--append-system-prompt" dev-system]
         (if (map/get-or run :resumable #f) ["--resume" s] ["--session-id" s]))]))

  (def (dev state n input)
    (let [run (run-of state n)
          id (try (submitted (call :jobs/run (dev-cmd run) {:stdin input :dir (map/get-or run :dir "") :as :text :timeout 30m})))]
      (ok (waiting state n :dev id))))

  (def (check state n)
    (let [{:check cmd :dir dir} (run-of state n)
          id (try (submitted (call :jobs/run cmd {:dir dir :timeout 10m})))]
      (ok (waiting state n :check id))))

  (def (passed? checked) (match checked [{:exit 0} #t] [_ #f]))

  ; tail is the last 4000 characters of s.
  (def (tail s) (string/slice s (max 0 (- (string/length s) 4000))))

  (def (check-text checked)
    (match checked
      [{:exit 0} "passed"]
      [{:exit n :stdout out :stderr e} (str "failed with exit " n ":\n" (tail (str out e)))]))

  (def (review state n checked)
    (let [{:dir dir :base base :task task} (run-of state n)
          _ (try (git dir ["add" "-A"]))
          diff (try (git dir ["diff" "--cached" base]))]
      (if (= diff "")
        (finish state n :failed "The developer changed nothing.")
        (let [input (str review-prompt "\n\nTask: " task "\n\nThe check " (check-text checked) "\n\nThe diff:\n" diff)
              id (try (submitted (call :jobs/run ["claude" "-p" "--strict-mcp-config" "--tools" "" "--no-session-persistence"]
                                   {:stdin input :dir dir :as :text :timeout 10m})))]
          (ok (waiting (set-run state n {:checked checked :diff diff}) n :review id))))))

  ; subject is task's first sentence, as a commit's subject: at most 72
  ; characters. The whole task goes in the commit's body.
  (def (subject task)
    (let [first (string/trim-suffix (match (string/split (string/trim task) ". ") [[f & _] f]) ".")]
      (if (> (string/length first) 72) (str (string/slice first 0 71) "…") first)))

  (test "a commit's subject is the task's first sentence"
    (= [(subject "  Add a flag. Then test it.") (subject "Add a flag.")] ["Add a flag" "Add a flag"]))

  (test "a long subject is cut to 72 characters"
    (let [long (string/join (vector/map (vector/range 0 30) (fn (i) "word")) " ")]
      (= (string/length (subject long)) 72)))

  (test "a check's output is cut to its last 4000 characters"
    (= [(string/length (tail (string/join (vector/map (vector/range 0 5000) (fn (i) "x")) ""))) (tail "abc")] [4000 "abc"]))

  (def (reviewed state n text)
    (let [{:round round :checked checked :dir dir :task task :branch branch} (run-of state n)
          ; A retried run has rounds more than it had.
          limit (map/get-or (run-of state n) :limit rounds)
          state (set-run state n {:review text})
          approved (string/contains? text "VERDICT: approve")]
      (cond
        [(and (passed? checked) approved)
         (do (try (git dir ["commit" "-q" "-m" (subject task) "-m" task]))
           (finish state n :ready (str "Committed on " branch " in " dir ", after " round " rounds. The last review:\n\n" text)))]
        [(>= round limit)
         (finish state n :gave-up (str "Not approved after " round " rounds; the work is in " dir ". The last review:\n\n" text))]
        [_
         (dev (set-run state n {:round (+ round 1)}) n
           (str (if approved "" (str "The reviewer asked for changes:\n\n" text "\n\n"))
             (if (passed? checked) "" (str "The check " (check-text checked) "\n\n"))
             "Fix what needs fixing."))])))

  ; ended? is whether a run at step ended without being ready.
  (def (ended? step) (vector/contains? [:gave-up :failed :cancelled] step))

  ; actions are what can be done about run n, on branch, once it ended as
  ; status: show its last review and diff; merge it if it is ready, or
  ; retry or discard it if it ended otherwise.
  (def (actions n status branch)
    (let [show {:label "Show review and diff" :action [:pipeline/show n]}]
      (cond
        [(= status :ready) [show {:label (str "Merge " branch) :action [:pipeline/merge n]}]]
        [(ended? status)
         [show {:label "Retry with a note" :action [:pipeline/retry n] :ask "A note for the developer, if any"}
          {:label "Discard" :action [:pipeline/discard n]}]]
        [_ [show]])))

  (test "a ready run can be merged, one that didn't end ready retried or discarded"
    (= [(actions 1 :ready "whiff/1") (actions 2 :gave-up "whiff/2") (actions 3 :merged "whiff/3")]
      [[{:label "Show review and diff" :action [:pipeline/show 1]}
        {:label "Merge whiff/1" :action [:pipeline/merge 1]}]
       [{:label "Show review and diff" :action [:pipeline/show 2]}
        {:label "Retry with a note" :action [:pipeline/retry 2] :ask "A note for the developer, if any"}
        {:label "Discard" :action [:pipeline/discard 2]}]
       [{:label "Show review and diff" :action [:pipeline/show 3]}]]))

  ; tidy removes run n's worktree and branch, as what was in them is
  ; merged or not wanted, and marks it step, :merged or :discarded.
  (def (tidy state n step)
    (let [{:repo repo :dir dir :branch b} (run-of state n)]
      (do (or-else (git repo ["worktree" "remove" "--force" dir]) "")
        (or-else (git repo ["branch" "-D" b]) "")
        (publish :pipeline/step {:run n :step step})
        (set-run state n {:step step}))))

  ; finish ends run n as status, telling you in your inbox unless it is
  ; quiet, with what you can do about it, and on :pipeline/done.
  (def (finish state n status note)
    (let [{:task task :branch branch :dir dir :quiet quiet} (run-of state n)]
      ; :me/tell answers pending, as it waits in your inbox.
      (do (if quiet :quiet (or-else (call :me/tell (str "pipeline " n ", " task ": " (keyword/name status) ". " note) {:actions (actions n status branch)}) :told))
        (publish :pipeline/done {:run n :status status :branch branch :dir dir :note note})
        ; After :pipeline/done, so a planner hears of the end first.
        (publish :pipeline/step {:run n :step status})
        (ok (set-run state n {:step status})))))

  ; failure is a run's note when a step failed with e, what saying which;
  ; and, if the step may still be running after whiff died, how to stop it.
  (def (failure what e)
    (str what ": " (value/to-string e)
      (match e
        [{:pid pid} (str "\n\nIt may still be running, as process group " pid ", and Retry refuses until it isn't. To stop it: kill -- -" pid)]
        [_ ""])))

  (test "a failure that may still be running says how to stop it"
    (= [(failure "The check didn't run" {:kind :start}) (string/contains? (failure "The developer failed" {:kind :interrupted :pid 42}) "kill -- -42")]
      ["The check didn't run: {:kind :start}" #t]))

  ; step-done takes run n on from the result r of the job it waited for at
  ; step; a run cancelled meanwhile stays as it is.
  (def (step-done state n step r)
    (let [run (run-of state n)]
      (cond
        [(not (= (map/get-or run :step :none) step)) (ok state)]
        [(= step :dev)
         (match r
           [(ok _) (check (set-run state n {:resumable #t}) n)]
           [(err e) (finish state n :failed (failure "The developer failed" e))])]
        [(= step :check)
         (match r
           [(ok checked) (review state n checked)]
           [(err e) (finish state n :failed (failure "The check didn't run" e))])]
        [_
         (match r
           [(ok text) (reviewed state n text)]
           [(err e) (finish state n :failed (failure "The reviewer failed" e))])])))

  ; stray is (ok (some pid)) if run's last job may still be running, in
  ; process group pid: whiff died while it ran, or it's being cancelled.
  (def (stray run)
    (match (map/get run :job)
      [(some id) (call :jobs/process id)]
      [(none) (ok (none))]))

  (def (active? step) (vector/contains? [:dev :check :review] step))

  ; retry-input is what the dev gets when you retry run: your note, if
  ; any, and the last review, in the session it has; or the task, with
  ; your note, in a new one.
  (def (retry-input run note)
    (let [noted (if (= note "") "" (str "A note from the user:\n\n" note "\n\n"))]
      (if (map/get-or run :resumable #f)
        (str noted
          (match (map/get run :review) [(some r) (str "The last review:\n\n" r "\n\n")] [(none) ""])
          "Fix what needs fixing.")
        (str "Task: " (map/get-or run :task "") "\n\n" noted))))

  (test "a retry resumes with your note and the last review, or starts again with the task"
    (= [(retry-input {:resumable #t :review "no tests"} "add them") (retry-input {:task "t"} "")]
      ["A note from the user:\n\nadd them\n\nThe last review:\n\nno tests\n\nFix what needs fixing." "Task: t\n\n"]))

  ; free is the first run number from n whose worktree and branch in repo
  ; aren't there: whiff dying as a run started leaves them without the run,
  ; as it had no state yet. They stay for you to look at.
  (def (free repo n)
    (loop [n n]
      (if (or (file/exists? (path/join home (str (path/base repo) "-" n)))
            (match (git repo ["rev-parse" "--verify" "-q" (str "refs/heads/whiff/" n)]) [(ok _) #t] [_ #f]))
        (recur (+ n 1))
        n)))

  ; begin starts a run on task in repo, from base, a commit or branch: [n
  ; state], or the err it couldn't start for.
  (def (begin state repo base task check quiet)
    (let [base (string/trim (try (git repo ["rev-parse" base])))
          n (free repo (map/get-or state :next 1))
          dir (path/join home (str (path/base repo) "-" n))
          branch (str "whiff/" n)
          session (uuid/new)
          _ (try (file/mkdir home))
          _ (try (git repo ["worktree" "add" "-q" "-b" branch dir base]))
          run {:task task :repo repo :dir dir :branch branch :base base :check check :round 1 :session session :step :starting :quiet quiet}
          state (-> state (map/set :next (+ n 1)) (map/set-in [:runs n] run))]
      ; A run that can't start leaves no worktree or branch behind.
      (match (dev state n (str "Task: " task))
        [(ok s) (ok [n s])]
        [(err e)
         (do (or-else (git repo ["worktree" "remove" "--force" dir]) "")
           (or-else (git repo ["branch" "-D" branch]) "")
           (err e))])))

  (on (start state task check) :write :update
    "Starts a run on task in the repository here: a dev Claude makes the change in a worktree of its own, check (a command, like [\"go\" \"test\" \"./...\"]) runs there, and a reviewer Claude reviews the diff, for up to 3 rounds; then it is committed on the run's branch and you hear how it went in your inbox. (ok n), the run's number."
    (begin state (string/trim (try (proc/output ["git" "rev-parse" "--show-toplevel"]))) "HEAD" task check #f))

  (on (start-on state repo base task check) :write :update
    "Starts a run as start does, in the repository at repo, from base, a commit or branch such as an earlier run's, without telling you how it ends (:pipeline/done still does): how a planner stacks runs. (ok n)."
    (begin state repo base task check #t))

  (on (runs state) :read
    "Every run, oldest first: {:run :task :step :round :branch :dir}, with :step one of :dev, :check, :review, :ready, :gave-up, :failed, :cancelled, :merged or :discarded."
    (ok (vector/map (map/entries (map/get-or state :runs {}))
          (fn ([n {:task t :step s :round r :branch b :dir d}]) {:run n :task t :step s :round r :branch b :dir d}))))

  (on (view state) :read
    "The runs as a view: each shows its last review and diff, cancels it while it runs, and merges it once ready or retries it once it ended otherwise, unless a planner runs it."
    (ok (view/items (vector/map (map/entries (map/get-or state :runs {}))
                      (fn ([n run])
                        (let [{:task t :step s :round r :branch b} run
                              show {:label "Show review and diff" :action [:pipeline/show n]}]
                          {:label (str n "  " t) :detail (str (keyword/name s) ", round " r ", " b)
                           :actions (cond
                                      [(active? s) [show {:label "Cancel the run" :action [:pipeline/cancel n]}]]
                                      [(map/get-or run :quiet #f) [show]]
                                      [_ (actions n s b)])})))
          {:changed :pipeline/step})))

  (on (show state n) :read
    "Run n, its last review and the diff that review was of, as a view of text; (err {:kind :no-run}) if there is no such run."
    (match (map/get-in state [:runs n])
      [(some run)
       (let [{:task t :step s :round r :branch b} run]
         (ok (view/text (str "Run " n ": " t "\n" (keyword/name s) ", round " r ", " b
                          "\n\nThe last review:\n\n" (map/get-or run :review "None yet.")
                          "\n\nThe diff it reviewed:\n\n" (map/get-or run :diff "None yet."))
               {:changed :pipeline/step})))]
      [_ (err {:kind :no-run :message (str "no run " n)})]))

  (on (cancel state n) :write :update
    "Cancels run n: kills the job it waits for and leaves its worktree as it is. (err {:kind :no-run}) if there is no such run, or it has ended."
    (match (map/get-in state [:runs n])
      [(some {:step s :job id}) when (active? s)
       (do (or-else (call :jobs/cancel id) :gone)
         (publish :pipeline/step {:run n :step :cancelled})
         (ok [:cancelled (set-run state n {:step :cancelled})]))]
      [_ (err {:kind :no-run :message (str "no run " n " is going")})]))

  (on (retry state n note) :write :update
    "Takes run n on after it gave up, failed or was cancelled, for up to 3 more rounds: the dev Claude, in the run's worktree, gets note, your words for it (\"\" for none), and the last review. (ok :retrying); (err {:kind :no-run}) unless run n ended so; (err {:kind :still-running :pid}) while its last job may still be running, as after whiff died while it ran."
    (match (map/get-in state [:runs n])
      [(some run) when (ended? (map/get-or run :step :none))
       ; Two devs in one worktree would undo each other's work.
       (match (try (stray run))
         [(some pid)
          (err {:kind :still-running :pid pid
                :message (str "run " n "'s last job may still be running, as process group " pid ": stop it (kill -- -" pid ") or let it end, then retry")})]
         [(none)
          (let [round (map/get-or run :round 1)
                ; A session no dev turn ended in may not exist: a new one.
                fresh (if (map/get-or run :resumable #f) {} {:session (uuid/new)})
                state (set-run state n (map/merge fresh {:round (+ round 1) :limit (+ round rounds)}))]
            (ok [:retrying (try (dev state n (retry-input (run-of state n) note)))]))])]
      [_ (err {:kind :no-run :message (str "run " n " hasn't ended without being ready: nothing to retry")})]))

  (on (merge state n) :write :update
    "Merges ready run n's branch into the branch checked out in its repository, only as a fast-forward, then removes the run's worktree and branch: (ok branch); git's error if your branch moved on or your changes are in the way, and (err {:kind :no-run}) unless run n is ready."
    (match (map/get-in state [:runs n])
      [(some {:step :ready :repo repo :branch b})
       (let [_ (try (git repo ["merge" "-q" "--ff-only" b]))]
         (ok [b (tidy state n :merged)]))]
      [_ (err {:kind :no-run :message (str "run " n " isn't ready: nothing to merge")})]))

  (on (discard state n) :write :update
    "Discards run n, ended and not merged: removes its worktree, uncommitted work and all, and its branch. (ok :discarded); (err {:kind :no-run}) unless run n ended so."
    (match (map/get-in state [:runs n])
      [(some {:step s}) when (or (= s :ready) (ended? s))
       (ok [:discarded (tidy state n :discarded)])]
      [_ (err {:kind :no-run :message (str "run " n " hasn't ended, or is gone: nothing to discard")})]))

  (on (whiff/done state id r) :update
    "A job a run waited for is done: the run takes its next step."
    (match (map/get-in state [:jobs id])
      [(none) (ok state)]
      [(some [n step])
       (let [state (map/update state :jobs (fn (js) (map/delete js id)))]
         (catch (step-done state n step r)
           [e (ok (or-else (finish state n :failed (value/to-string e)) state))]))])))
