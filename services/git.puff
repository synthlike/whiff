; git: the repository in the caller's directory. Read only.
;   whiff call git/status
;   whiff call git/branch
;   whiff call git/changes    ; the changed files, as file: what changed

; It runs git with literal commands, which whiff knows only read, so its
; functions are :read without claiming it; git fails with (err {:kind
; :exit}) and what it said, outside a repository say.

(service git
  ; change is one letter of a status's XY as a keyword.
  (def (change c)
    (match c
      ["." :none] ["M" :modified] ["T" :modified] ["A" :added] ["D" :deleted]
      ["R" :renamed] ["C" :copied] ["U" :unmerged] [_ :unknown]))

  (def (file xy path)
    {:path path :index (change (string/slice xy 0 1)) :work (change (string/slice xy 1 2))})

  ; after is the fields from i on: a path, which may hold spaces.
  (def (after fields i) (string/join (vector/slice fields i) " "))

  (def (number s) (unwrap (int/from-string (string/slice s 1))))

  (def (with-file st f) (map/update st :files (fn (fs) (vector/append fs f))))

  ; add adds one line of git status --porcelain=v2 --branch to st.
  (def (add st line)
    (let [f (string/split line " ")]
      (match f
        [["#" "branch.head" "(detached)"] st]
        [["#" "branch.head" b] (map/set st :branch (some b))]
        [["#" "branch.upstream" u] (map/set st :upstream (some u))]
        [["#" "branch.ab" a b] (map/merge st {:ahead (number a) :behind (number b)})]
        [["1" xy & _] (with-file st (file xy (after f 8)))]
        ; A rename's path is followed by a tab and the path it had.
        [["2" xy & _] (with-file st (file xy (match (string/split (after f 9) "\t") [[p & _] p])))]
        [["u" xy & _] (with-file st (file xy (after f 10)))]
        [["?" & _] (with-file st {:path (after f 1) :index :untracked :work :untracked})]
        [_ st])))

  (test "a status: its branch, how far it is from upstream, and its files"
    (= (vector/reduce ["# branch.oid abc" "# branch.head main" "# branch.upstream origin/main" "# branch.ab +2 -1"
                       "1 .M N... 100644 100644 100644 abc def go.mod"
                       "2 R. N... 100644 100644 100644 abc def R100 new name.go\told.go"
                       "? notes file.txt"]
         {:branch (none) :upstream (none) :ahead 0 :behind 0 :files []} add)
       {:branch (some "main") :upstream (some "origin/main") :ahead 2 :behind 1
        :files [{:path "go.mod" :index :none :work :modified}
                {:path "new name.go" :index :renamed :work :none}
                {:path "notes file.txt" :index :untracked :work :untracked}]}))

  (test "a detached HEAD has no branch"
    (= (add {:branch (none)} "# branch.head (detached)") {:branch (none)}))

  (def (status-of)
    (let [out (try (proc/output ["git" "-c" "core.quotePath=false" "status" "--porcelain=v2" "--branch"]))]
      (ok (vector/reduce (string/lines out) {:branch (none) :upstream (none) :ahead 0 :behind 0 :files []} add))))

  ; what is what changed in a file, in a word: the work tree's change, or
  ; the index's if the work tree has none.
  (def (what f)
    (match f
      [{:index i :work :none} (keyword/name i)]
      [{:work w} (keyword/name w)]))

  (on (status)
    "The branch, (some name) or (none) when detached; its upstream, an Option too; commits :ahead and :behind it; and each changed file, {:path :index :work}, with what changed in the index and the work tree: :none, :modified, :added, :deleted, :renamed, :copied, :unmerged or :untracked."
    (status-of))

  (on (changes)
    "The changed files as a view of locations, each noted with what changed in it."
    (let [root (string/trim (try (proc/output ["git" "rev-parse" "--show-toplevel"])))
          {:files files} (try (status-of))]
      (ok (view/locations (vector/map files (fn (f) (match f [{:path p} {:file (path/join root p) :note (what f)}])))))))

  (on (branch)
    "The current branch's name; (err {:kind :detached}) when HEAD isn't on one."
    (match (string/trim (try (proc/output ["git" "branch" "--show-current"])))
      ["" (err {:kind :detached :message "HEAD isn't on a branch"})]
      [b (ok b)])))
