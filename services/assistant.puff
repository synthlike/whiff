; assistant: a resident agent you talk to by leaving it messages. Each
; message wakes Claude for one turn of the same session, so it remembers the
; whole conversation, days apart; its answer lands in your inbox. Replying
; to an answer is your next message. It has no tools: it reads what you send
; and answers. Needs the claude CLI.
;   whiff call assistant/tell "the release is on Friday; remind me what's left"
;   whiff inbox                  ; its answer, from :assistant
;   whiff reply 7 "and the docs?"   ; the next message; or :seen to dismiss
;
;   whiff call assistant/forget  ; start a new conversation
;
; Its home, ~/.whiff/agents/<its name>, holds its session's id (Claude keeps
; sessions per directory) and the ids of the turns it started. Its turns
; are :agent's. Copy the file under another name for another agent.

(service assistant
  (def name (string/slice (value/to-string (self)) 1))
  (def home (path/join (os/home) ".whiff" "agents" name))
  (def session-file (path/join home "session")) ; the conversation's id
  (def started (path/join home "started"))      ; the id once it has begun
  (def turns (path/join home "turns"))          ; each turn's job id, a line each
  (def system (str "You are " name ", " """
    a long-running agent living in whiff, the user's personal message
    daemon. The user leaves you messages, which arrive as turns of one
    conversation, sometimes days apart. You have no tools. Answer briefly and
    plainly: your answer is left in the user's inbox, and their reply to it
    is their next message.
    """))

  (def (read-file path) (string/trim (or-else (file/read-text path) "")))

  ; session is the conversation's id, made on its first turn.
  (def (session)
    (match [(read-file session-file) (read-file started)]
      [["" ""]
       (let [id (uuid/new)]
         (do (try (file/write session-file id)) (ok id)))]
      [["" s] (ok s)] ; begun before there was a session file
      [[s _] (ok s)]))

  (def (claude id)
    (vector/concat ["claude" "-p" "--tools" "" "--append-system-prompt" system]
      (if (= (read-file started) id) ["--resume" id] ["--session-id" id])))

  (def (read-turns) (string/lines (or-else (file/read-text turns) "")))

  ; busy? is whether the last turn's job still runs.
  (def (busy?)
    (match [(vector/last (read-turns)) (call :jobs/list)]
      [[(some last) (ok js)]
       (vector/any? js (fn ({:id i}) (= (int/to-string i) last)))]
      [_ #f]))

  ; turn starts one turn with text: (ok :thinking), or (err {:kind :busy}).
  (def (turn text)
    (if (busy?)
      (err {:kind :busy :message (string/concat name " is still answering your last message; send it again in a moment")})
      (do (try (file/mkdir home))
        (catch (call :jobs/run (claude (try (session))) {:stdin text :dir home :as :text :timeout 10m :origin :agent})
          [{:kind :pending :id id}
           (do (try (file/append turns (str id "\n")))
             (ok :thinking))]))))

  ; answered leaves a turn's answer in your inbox.
  (def (answered r)
    (match r
      [(ok answer) (do (try (file/write started (try (session)))) (call :me/tell (string/trim answer)))]
      [(err {:kind :exit :stderr e}) when (string/contains? e "already in use")
       (do (try (file/write started (try (session))))
         (call :me/tell "My session had already begun, so that message was lost; please send it again."))]
      [(err e) (call :me/tell (string/concat "I couldn't answer: " (value/to-string e)))]))

  (on (tell text)
    "Leaves the assistant a message: (ok :thinking) now, and its answer in your inbox; (err {:kind :busy}) while it answers the last one."
    (turn text))

  (on (forget)
    "Ends the conversation: the next message starts a new one, which remembers nothing."
    (do (try (file/write session-file ""))
      (try (file/write started ""))
      (ok :forgotten)))

  (on (whiff/done id r)
    "A turn's answer goes to your inbox; your reply to one, if it is text, is the next message."
    (cond
      [(vector/contains? (read-turns) (int/to-string id)) (answered r)]
      [_ (match r
           [(ok text) when (= (value/type text) :string)
            (match (turn text)
              [(err {:kind :busy}) (call :me/tell "I'm still answering your last message; reply again in a moment.")]
              [res res])]
           [_ (ok :done)])])))
