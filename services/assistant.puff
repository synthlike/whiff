; assistant: a resident agent you talk to by leaving it messages. Each
; message wakes Claude for one turn of the same session, so it remembers the
; whole conversation, days apart; its answer lands in your inbox. Replying
; to an answer is your next message. It has no tools: it reads what you send
; and answers. Needs the claude CLI.
;   whiff call assistant/tell "the release is on Friday; remind me what's left"
;   whiff inbox                  ; its answer, from :assistant
;   whiff reply 7 "and the docs?"   ; the next message; or :seen to dismiss
;
; Its home, ~/.whiff/agents/assistant, holds the session (Claude keeps
; sessions per directory) and the ids of the turns it started.

(srv assistant
  (def home (path/join (match (env/get "HOME") [(some h) h]) ".whiff" "agents" "assistant"))
  (def started (path/join home "started")) ; the session has begun
  (def turns (path/join home "turns"))     ; each turn's job id, a line each

  ; session is the conversation's id; a new one starts afresh.
  (def session "9eebd883-066f-471c-860a-cc5af46fe9bc")
  (def system "You are assistant, a long-running agent living in whiff, the user's personal message daemon. The user leaves you messages, which arrive as turns of one conversation, sometimes days apart. You have no tools. Answer briefly and plainly: your answer is left in the user's inbox, and their reply to it is their next message.")

  (def (claude)
    (vector/concat ["claude" "-p" "--tools" "" "--append-system-prompt" system]
      (if (file/exists? started) ["--resume" session] ["--session-id" session])))

  (def (read-turns) (match (file/read-text turns) [(ok s) (string/lines s)] [_ []]))

  ; busy? is whether the last turn's job still runs.
  (def (busy?)
    (match [(vector/last (read-turns)) (call :jobs/list)]
      [[(some last) (ok js)]
       (vector/contains? (vector/map js (fn (j) (match j [{:id i} (int/to-string i)]))) last)]
      [_ #f]))

  ; turn starts one turn with text: (ok :thinking), or (err {:kind :busy}).
  (def (turn text)
    (if (busy?)
      (err {:kind :busy :message "assistant is still answering your last message; send it again in a moment"})
      (do (try (proc/run ["mkdir" "-p" home]))
          (match (call :jobs/run (claude) {:stdin text :dir home :as :text :timeout 10m})
            [(err {:kind :pending :id id})
             (do (try (file/write turns (string/concat (string/join (vector/append (read-turns) (int/to-string id)) "\n") "\n")))
                 (ok :thinking))]
            [e e]))))

  ; answered leaves a turn's answer in your inbox.
  (def (answered r)
    (match r
      [(ok answer) (do (try (file/write started session)) (call :me/tell (string/trim answer)))]
      [(err {:kind :exit :stderr e}) when (string/contains? e "already in use")
       (do (try (file/write started session))
           (call :me/tell "My session had already begun, so that message was lost; please send it again."))]
      [(err e) (call :me/tell (string/concat "I couldn't answer: " (value/to-string e)))]))

  (on (tell text)
    "Leaves the assistant a message: (ok :thinking) now, and its answer in your inbox; (err {:kind :busy}) while it answers the last one."
    (turn text))

  (on (whiff/done id r)
    "A turn's answer goes to your inbox; your reply to one, if it is text, is the next message."
    (cond
      [(vector/contains? (read-turns) (int/to-string id)) (answered r)]
      [#t (match r
            [(ok text) when (= (value/type text) :string)
             (match (turn text)
               [(err {:kind :busy}) (call :me/tell "I'm still answering your last message; reply again in a moment.")]
               [res res])]
            [_ (ok :done)])])))
